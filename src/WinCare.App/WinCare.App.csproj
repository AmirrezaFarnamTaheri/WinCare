<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WinCare.App</RootNamespace>
    <AssemblyName>WinCare.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinCare.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishProfile Condition="'$(WindowsPackageType)' != 'None'">Properties\PublishProfiles\win-$(Platform).pubxml</PublishProfile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinCare.Application\WinCare.Application.csproj" />
    <ProjectReference Include="..\WinCare.Domain\WinCare.Domain.csproj" />
    <ProjectReference Include="..\WinCare.CommandCatalog\WinCare.CommandCatalog.csproj" />
    <ProjectReference Include="..\WinCare.Infrastructure\WinCare.Infrastructure.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <_WinCareRustTarget Condition="'$(Platform)' == 'x64'">x86_64-pc-windows-msvc</_WinCareRustTarget>
    <_WinCareRustTarget Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</_WinCareRustTarget>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="Native\$(Platform)\wincare_core.dll"
      Condition="Exists('Native\$(Platform)\wincare_core.dll')"
      Link="wincare_core.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateNativeCoreDll" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Error
      Condition="!Exists('Native\$(Platform)\wincare_core.dll')"
      Text="Release build requires Native\$(Platform)\wincare_core.dll. Build Rust first: cargo build --manifest-path native/Cargo.toml --target $(_WinCareRustTarget) --release and stage to src/WinCare.App/Native/$(Platform)/wincare_core.dll. See docs/migration/windows-validation.md." />
  </Target>
</Project>
