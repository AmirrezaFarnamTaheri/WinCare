<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WinCare.App</RootNamespace>
    <AssemblyName>WinCare.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinCare.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultItemExcludes>$(DefaultItemExcludes);AppPackages\**</DefaultItemExcludes>
    <PublishProfile Condition="'$(WindowsPackageType)' != 'None'">Properties\PublishProfiles\win-$(Platform).pubxml</PublishProfile>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="AppPackages\**" />
    <None Remove="AppPackages\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinCare.Application\WinCare.Application.csproj" />
    <ProjectReference Include="..\WinCare.Domain\WinCare.Domain.csproj" />
    <ProjectReference Include="..\WinCare.CommandCatalog\WinCare.CommandCatalog.csproj" />
    <ProjectReference Include="..\WinCare.Infrastructure\WinCare.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="WinCare.App" />
    <TrimmerRootAssembly Include="WinCare.Domain" />
    <TrimmerRootAssembly Include="WinCare.CommandCatalog" />
    <TrimmerRootAssembly Include="WinCare.Application" />
    <TrimmerRootAssembly Include="WinCare.Infrastructure" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <AppxPackageSigningEnabled Condition="'$(PackageCertificateKeyFile)' != ''">true</AppxPackageSigningEnabled>
    <_WinCareRustTarget Condition="'$(Platform)' == 'x64'">x86_64-pc-windows-msvc</_WinCareRustTarget>
    <_WinCareRustTarget Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</_WinCareRustTarget>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="Native\$(Platform)\wincare_core.dll"
      Condition="Exists('Native\$(Platform)\wincare_core.dll')"
      Link="wincare_core.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateNativeCoreDll" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Error
      Condition="!Exists('Native\$(Platform)\wincare_core.dll')"
      Text="Release build requires Native\$(Platform)\wincare_core.dll. Build Rust first: cargo build --manifest-path native/Cargo.toml --target $(_WinCareRustTarget) --release and stage to src/WinCare.App/Native/$(Platform)/wincare_core.dll. See docs/migration/windows-validation.md." />
  </Target>

  <!-- The MSIX Identity Version must be a four-part number (prerelease suffixes are not
       representable). Derive it at package time from VersionPrefix instead of trusting the
       checked-in literal: pass -p:AppxPackageVersion=x.y.z.w to override, otherwise the
       prefix (2.5.0) becomes 2.5.0.0. -->
  <PropertyGroup>
    <AppxPackageVersion Condition="'$(AppxPackageVersion)' == ''">$(VersionPrefix).0</AppxPackageVersion>
  </PropertyGroup>

  <Target Name="StampAppxManifestVersion" BeforeTargets="Build" Condition="'$(GenerateAppxPackageOnBuild)' == 'true'">
    <XmlPoke
      XmlInputPath="Package.appxmanifest"
      Query="/p:Package/p:Identity/@Version"
      Value="$(AppxPackageVersion)"
      Namespaces="&lt;Namespace Prefix='p' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;" />
  </Target>

  <!-- Prune unused DirectML, ONNX runtime, Widgets, WebView2, and Windows.AI projections from unpackaged portable single-file bundle -->
  <!-- ponytail: ultra - trim dead weight without affecting WinUI 3 runtime stability -->
  <Target Name="PruneUnusedHeavyweightProjections" BeforeTargets="_ComputeFilesToBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_PruneFiles Include="@(ResolvedFileToPublish)" Condition="
        $([System.String]::Copy('%(Filename)').Contains('DirectML')) or
        $([System.String]::Copy('%(Filename)').Contains('onnxruntime')) or
        $([System.String]::Copy('%(Filename)').Contains('PerceptiveStreaming')) or
        $([System.String]::Copy('%(Filename)').Contains('NPUDetect')) or
        $([System.String]::Copy('%(Filename)').Contains('WebView2')) or
        $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Windows.Widgets')) or
        $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Windows.AI')) or
        $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Windows.Workloads')) or
        $([System.String]::Copy('%(Filename)').StartsWith('workloads.')) or
        $([System.String]::Copy('%(Filename)').StartsWith('packages.')) or
        $([System.String]::Copy('%(Filename)').EndsWith('.lock')) or
        $([System.String]::Copy('%(RelativeDir)').StartsWith('Native')) or
        ('%(Extension)' == '.mui' and !$([System.String]::Copy('%(RelativeDir)').ToLower().Contains('en-us')) and !$([System.String]::Copy('%(RelativeDir)').ToLower().Contains('en-gb')))" />
      <ResolvedFileToPublish Remove="@(_PruneFiles)" />
    </ItemGroup>
    <Message Importance="high" Text="Pruned unused heavyweight projections from portable bundle." />
  </Target>
</Project>
