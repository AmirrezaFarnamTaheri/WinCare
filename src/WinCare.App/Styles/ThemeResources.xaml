<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!--
            Static values are pinned by tools/verify_pill_contrast.py,
            tools/verify_palette_contrast.py and tests/native/test_visual_contrast.py:
            every runtime fg/bg pairing must clear WCAG 2.1 AA 4.5:1. Re-tune by
            measurement, never by eye. HighContrast defers to Windows system colors;
            status pills there carry meaning via text and borders, not fill hues.
        -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F7F7F2" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#ECEFE8" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#EDF1EB" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E1E7DF" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#CCD5C9" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D2925" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#425950" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#176342" />
            <SolidColorBrush x:Key="WarningBrush" Color="#78500F" />
            <SolidColorBrush x:Key="DangerBrush" Color="#A92B35" />
            <SolidColorBrush x:Key="AccentChromeBrush" Color="#0E6254" />
            <SolidColorBrush x:Key="AccentChromeSubtleBrush" Color="#DCEEE7" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TelemetryFrameBrush" Color="#EEF2EB" />
            <SolidColorBrush x:Key="NavigationRailBrush" Color="#EFF1EC" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#D3DBD0" />
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#E5EFE6" />
            <SolidColorBrush x:Key="AccentBrush" Color="#0E6254" />
            <SolidColorBrush x:Key="PillReadOnlyBgBrush" Color="#155A48" />
            <SolidColorBrush x:Key="PillMutatingBgBrush" Color="#A92B35" />
            <SolidColorBrush x:Key="PillElevatedBgBrush" Color="#CA8E32" />
            <SolidColorBrush x:Key="PillVerifiedBorderBrush" Color="#155A48" />
            <SolidColorBrush x:Key="PillNotReadyBgBrush" Color="#E2EAE2" />
            <SolidColorBrush x:Key="PillTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PillAltTextBrush" Color="#1D2925" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#161F1B" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#18241F" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#202B26" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#293A32" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#374A3E" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#455B4F" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F5EC" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C0CEBE" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0C2319" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#8BE0A6" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFD08C" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFB0A7" />
            <SolidColorBrush x:Key="AccentChromeBrush" Color="#7CDFB5" />
            <SolidColorBrush x:Key="AccentChromeSubtleBrush" Color="#253F35" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="#202B26" />
            <SolidColorBrush x:Key="TelemetryFrameBrush" Color="#1C3027" />
            <SolidColorBrush x:Key="NavigationRailBrush" Color="#1B2A23" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#455B4F" />
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#263F32" />
            <SolidColorBrush x:Key="AccentBrush" Color="#7CDFB5" />
            <SolidColorBrush x:Key="PillReadOnlyBgBrush" Color="#155A48" />
            <SolidColorBrush x:Key="PillMutatingBgBrush" Color="#8F2530" />
            <SolidColorBrush x:Key="PillElevatedBgBrush" Color="#664B16" />
            <SolidColorBrush x:Key="PillVerifiedBorderBrush" Color="#8BE0A6" />
            <SolidColorBrush x:Key="PillNotReadyBgBrush" Color="#384A3E" />
            <SolidColorBrush x:Key="PillTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PillAltTextBrush" Color="#F2F5EC" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentChromeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentChromeSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TelemetryFrameBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavigationRailBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PillReadOnlyBgBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PillMutatingBgBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PillElevatedBgBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PillVerifiedBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PillNotReadyBgBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PillTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="PillAltTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
