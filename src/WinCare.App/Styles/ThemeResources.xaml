<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#EDF2F5" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#E4ECF1" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#F2F6F8" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E0EBF0" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#CBD8E0" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172D3B" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#435C6B" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#8A5700" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="AccentTealBrush" Color="#006B80" />
            <SolidColorBrush x:Key="AccentTealSubtleBrush" Color="#DCEFF2" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TelemetryFrameBrush" Color="#E6EFF3" />
            <SolidColorBrush x:Key="NavigationRailBrush" Color="#E4ECF1" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#CBD8E0" />
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#E5EFF4" />
            <SolidColorBrush x:Key="AccentBrush" Color="#006B80" />
            <SolidColorBrush x:Key="PillReadOnlyBgBrush" Color="#047857" />
            <SolidColorBrush x:Key="PillMutatingBgBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="PillElevatedBgBrush" Color="#D97706" />
            <SolidColorBrush x:Key="PillVerifiedBorderBrush" Color="#047857" />
            <SolidColorBrush x:Key="PillNotReadyBgBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="PillTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PillAltTextBrush" Color="#1A1A1A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#101B24" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#101B24" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#182A35" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#203542" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2B4655" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#36505E" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF5F7" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0C4CE" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#06151C" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#75D36B" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFCB45" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="AccentTealBrush" Color="#70D6DF" />
            <SolidColorBrush x:Key="AccentTealSubtleBrush" Color="#203F4A" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="#182A35" />
            <SolidColorBrush x:Key="TelemetryFrameBrush" Color="#14232D" />
            <SolidColorBrush x:Key="NavigationRailBrush" Color="#14232D" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#36505E" />
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#14232D" />
            <SolidColorBrush x:Key="AccentBrush" Color="#70D6DF" />
            <SolidColorBrush x:Key="PillReadOnlyBgBrush" Color="#047857" />
