<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!--
            Static values are pinned by tools/verify_pill_contrast.py,
            tools/verify_palette_contrast.py and tests/native/test_visual_contrast.py:
            every runtime fg/bg pairing must clear WCAG 2.1 AA 4.5:1. Re-tune by
            measurement, never by eye. HighContrast defers to Windows system colors;
            status pills there carry meaning via text and borders, not fill hues.
        -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F2F4F7" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#EAEEF2" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#EDF1F5" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E1E8EE" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#D5DDE4" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#14202B" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3D5568" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#0E700E" />
            <SolidColorBrush x:Key="WarningBrush" Color="#7A4B00" />
            <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
            <SolidColorBrush x:Key="AccentChromeBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="AccentChromeSubtleBrush" Color="#D6EAF7" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TelemetryFrameBrush" Color="#E9EFF4" />
            <SolidColorBrush x:Key="NavigationRailBrush" Color="#EAEEF2" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#D5DDE4" />
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#DFEAF2" />
            <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="PillReadOnlyBgBrush" Color="#0E700E" />
            <SolidColorBrush x:Key="PillMutatingBgBrush" Color="#B42318" />
            <SolidColorBrush x:Key="PillElevatedBgBrush" Color="#C97A0A" />
            <SolidColorBrush x:Key="PillVerifiedBorderBrush" Color="#0E700E" />
            <SolidColorBrush x:Key="PillNotReadyBgBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="PillTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PillAltTextBrush" Color="#14202B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#1C2733" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#1C2733" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#26313D" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#2E3B49" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#374656" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#46586A" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAF0F5" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AFC0CD" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0A1E2C" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#7BD389" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFCF8F" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF9C94" />
            <SolidColorBrush x:Key="AccentChromeBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="AccentChromeSubtleBrush" Color="#1E3B4F" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="#26313D" />
            <SolidColorBrush x:Key="TelemetryFrameBrush" Color="#202B37" />
            <SolidColorBrush x:Key="NavigationRailBrush" Color="#202B37" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#46586A" />
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#202B37" />
            <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="PillReadOnlyBgBrush" Color="#124F12" />
            <SolidColorBrush x:Key="PillMutatingBgBrush" Color="#8E1B13" />
            <SolidColorBrush x:Key="PillElevatedBgBrush" Color="#6B4100" />
            <SolidColorBrush x:Key="PillVerifiedBorderBrush" Color="#7BD389" />
            <SolidColorBrush x:Key="PillNotReadyBgBrush" Color="#374656" />
            <SolidColorBrush x:Key="PillTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PillAltTextBrush" Color="#F2F5F8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentChromeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentChromeSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TelemetryFrameBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavigationRailBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PillReadOnlyBgBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PillMutatingBgBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PillElevatedBgBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PillVerifiedBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PillNotReadyBgBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PillTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="PillAltTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
