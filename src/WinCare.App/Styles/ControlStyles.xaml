<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="TelemetryFontFamily">Cascadia Code, Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>

    <CornerRadius x:Key="RadiusPill">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusCardOuter">12</CornerRadius>
    <CornerRadius x:Key="RadiusCardInner">8</CornerRadius>

    <!-- Spacing scale backing the four-DIP rhythm in DESIGN.md; page markup must bind to
         these instead of inline Thickness literals. -->
    <Thickness x:Key="SpacingNone">0</Thickness>
    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingS">8</Thickness>
    <Thickness x:Key="SpacingM">12</Thickness>
    <Thickness x:Key="SpacingL">16</Thickness>
    <Thickness x:Key="SpacingXL">24</Thickness>
    <Thickness x:Key="SpacingXXL">32</Thickness>
    <x:Double x:Key="GapXS">4</x:Double>
    <x:Double x:Key="GapS">8</x:Double>
    <x:Double x:Key="GapM">12</x:Double>
    <x:Double x:Key="GapL">16</x:Double>
    <x:Double x:Key="GapXL">24</x:Double>

    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" /><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="QuietButtonStyle" TargetType="Button"><Setter Property="MinHeight" Value="44" /><Setter Property="MinWidth" Value="44" /><Setter Property="Padding" Value="16,10" /><Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" /><Setter Property="Background" Value="{ThemeResource SurfaceSecondaryBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" /></Style>
    <Style x:Key="DiagnosticChannelStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="12" /><Setter Property="MinHeight" Value="72" /><Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentChromeBrush}" /><Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource SurfaceBrush}" /></Style>
    <Style x:Key="AppTitleTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" /><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" /></Style>
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" /><Setter Property="FontSize" Value="34" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <!-- Status-masthead step: the verdict of the latest checkup is the app's strongest
         sentence and outranks even the page title. Owned here so the scale stays central. -->
    <Style x:Key="HeroTitleTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" /><Setter Property="FontSize" Value="40" /><Setter Property="LineHeight" Value="48" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <!-- Recurring structural device for entry points: the existing accent pair as a tile. -->
    <Style x:Key="IconTileStyle" TargetType="Border"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" /><Setter Property="Background" Value="{ThemeResource AccentChromeSubtleBrush}" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style x:Key="PageDescriptionTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" /><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="21" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" /></Style>
    <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="RowTitleTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" /><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="RowSecondaryTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" /><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="18" /><Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" /><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="21" /><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="FieldHintTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" /><Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="MetricTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" /><Setter Property="FontSize" Value="24" /><Setter Property="LineHeight" Value="32" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="StatusTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="TelemetryTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="SurfaceBorderStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardSurfaceBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource RadiusCardOuter}" /></Style>
    <Style x:Key="DashboardCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceBorderStyle}"><Setter Property="Padding" Value="24" /></Style>
    <Style x:Key="AccentButtonStyle" TargetType="Button"><Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="20,12" /><Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" /><Setter Property="MinHeight" Value="44" /><Setter Property="MinWidth" Value="44" /></Style>
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}" />
    <ControlTemplate x:Key="StatusPillTemplate" TargetType="ContentControl"><Border Padding="8,4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusPill}"><ContentPresenter FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate>
    <Style TargetType="ListViewItem"><Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentChromeBrush}" /><Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource SurfaceBrush}" /><Setter Property="FocusVisualPrimaryThickness" Value="3" /><Setter Property="FocusVisualMargin" Value="-3" /><Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" /></Style>
    <Style x:Key="RecommendationButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}"><Setter Property="Background" Value="{ThemeResource CardSurfaceBrush}" /><Setter Property="Padding" Value="18" /><Setter Property="MinHeight" Value="96" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style x:Key="StatusRowButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="10,8" /><Setter Property="MinHeight" Value="44" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
</ResourceDictionary>
