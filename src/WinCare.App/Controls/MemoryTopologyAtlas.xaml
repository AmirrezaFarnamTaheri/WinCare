<UserControl
    x:Class="WinCare.App.Controls.MemoryTopologyAtlas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource DashboardCardStyle}" Padding="16">
        <StackPanel Spacing="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="KERNEL MEMORY TOPOLOGY" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <Border Background="{ThemeResource AccentChromeSubtleBrush}" Padding="6,1" CornerRadius="2">
                        <TextBlock Text="LIVE TELEMETRY" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10" Foreground="{ThemeResource AccentChromeBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TotalMemoryBlock" Grid.Column="1" Text="64.0 GB TOTAL" 
                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" FontWeight="SemiBold" />
            </Grid>

            <Grid Height="18" CornerRadius="3" Background="{ThemeResource SurfaceSecondaryBrush}" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColActive" Width="3*" />
                    <ColumnDefinition x:Name="ColStandby" Width="2*" />
                    <ColumnDefinition x:Name="ColFree" Width="5*" />
                </Grid.ColumnDefinitions>

                <Rectangle Fill="{ThemeResource AccentChromeBrush}" ToolTipService.ToolTip="Active In-Use Memory" />
                <Rectangle Grid.Column="1" Fill="#5C7C99" Margin="1,0,0,0" ToolTipService.ToolTip="Standby Cache (Reclaimable)" />
                <Rectangle Grid.Column="2" Fill="{ThemeResource CardBorderBrush}" Margin="1,0,0,0" ToolTipService.ToolTip="Free / Available" />
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentChromeBrush}" />
                        <TextBlock Text="Active:" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtActive" Text="--" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#5C7C99" />
                        <TextBlock Text="Standby:" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtStandby" Text="--" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#5C7C99" />
                        <TextBlock Text="Free:" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtFree" Text="--" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BtnCompact" Grid.Column="1" Content="Purge Standby Cache" 
                        Style="{StaticResource QuietButtonStyle}" 
                        Click="BtnCompact_Click"
                        FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Padding="10,4" MinHeight="28" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
