<UserControl
    x:Class="WinCare.App.Controls.MemoryTopologyAtlas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource DashboardCardStyle}" Padding="20">
        <StackPanel Spacing="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Kernel memory topology" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <Border Background="{ThemeResource AccentChromeSubtleBrush}" Padding="6,2" CornerRadius="{StaticResource RadiusPill}">
                        <TextBlock Text="Live telemetry" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentChromeBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TotalMemoryBlock" Grid.Column="1" Text="-- total" 
                           FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" />
            </Grid>

            <Grid Height="18" CornerRadius="{StaticResource RadiusPill}" Background="{ThemeResource SurfaceSecondaryBrush}" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColActive" Width="1*" />
                    <ColumnDefinition x:Name="ColFree" Width="1*" />
                </Grid.ColumnDefinitions>

                <Rectangle Fill="{ThemeResource AccentChromeBrush}" ToolTipService.ToolTip="Active memory in use" />
                <Rectangle Grid.Column="1" Fill="{ThemeResource CardBorderBrush}" Margin="1,0,0,0" ToolTipService.ToolTip="Available memory (cache and free)" />
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentChromeBrush}" />
                        <TextBlock Text="In use:" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtActive" Text="--" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource CardBorderBrush}" />
                        <TextBlock Text="Available:" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtFree" Text="--" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Foreground="{ThemeResource SuccessBrush}" Visibility="Collapsed" />
                    <Button x:Name="BtnCompact" Content="Reclaim standby memory"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="BtnCompact_Click"
                            AutomationProperties.Name="Reclaim standby cache memory"
                            FontSize="11" Padding="12,6" MinHeight="32" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
