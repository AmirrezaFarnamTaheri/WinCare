<UserControl
    x:Class="WinCare.App.Controls.CareToolList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinCare.App.ViewModels.Pages"
    xmlns:views="using:WinCare.App.Views"
    SizeChanged="Control_SizeChanged">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Select a tool to inspect its options, requirements, and available actions." />
        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="ColumnHeaders" Padding="20,14" ColumnSpacing="24" Background="{ThemeResource SurfaceSecondaryBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="Tool"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}" Text="Catalog status"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}" Text="Requirements"/>
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CurrentRows, Mode=OneWay}"
                    SelectionMode="None" IsItemClickEnabled="True" ItemClick="Tool_ItemClick"
                    AutomationProperties.Name="Tools in this section">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="84"/><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/></Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageRow">
                            <Grid Padding="20,16" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="24" Visibility="{x:Bind views:LayoutVisibility.InvertBoolToVisibility(IsCompact), Mode=OneWay}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}"/><TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind Description}"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind LatestActivity}" Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(HasActivity)}"/></StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind State, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Detail, Mode=OneWay}"/>
                                </Grid>
                                <StackPanel Spacing="8" Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(IsCompact), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}"/>
                                    <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind Description}"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind LatestActivity}" Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(HasActivity)}"/>
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind State, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Detail, Mode=OneWay}"/>
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <InfoBar Grid.Row="1" VerticalAlignment="Top" IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" IsClosable="False" Title="No matching tools" Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Severity="Informational"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
