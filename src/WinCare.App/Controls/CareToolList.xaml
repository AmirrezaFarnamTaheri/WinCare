<UserControl
    x:Class="WinCare.App.Controls.CareToolList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinCare.App.ViewModels.Pages"
    xmlns:views="using:WinCare.App.Views"
    SizeChanged="Control_SizeChanged">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="Choosing a task opens its details in Power tools. It does not run it." />

        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Visibility="{x:Bind views:LayoutVisibility.InvertBoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Grid x:Name="ColumnHeaders" Padding="20,12" ColumnSpacing="24" Background="{ThemeResource SurfaceSecondaryBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="220" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="Task" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}" Text="Impact" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}" Text="Requirements" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CurrentRows, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Tool_ItemClick" AutomationProperties.Name="Tasks in this section">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="84" /><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" /></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageRow">
                            <Grid Padding="20,16" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="24" Visibility="{x:Bind views:LayoutVisibility.InvertBoolToVisibility(IsCompact), Mode=OneWay}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" /><TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind Description}" /><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind LatestActivity}" Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(HasActivity)}" /></StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind State, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Detail, Mode=OneWay}" />
                                </Grid>
                                <StackPanel Spacing="8" Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(IsCompact), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" />
                                    <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind Description}" />
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" FontWeight="SemiBold" Text="{x:Bind State, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Detail, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind LatestActivity}" Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(HasActivity)}" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>
        </Border>
<InfoBar Grid.Row="1" Margin="0" VerticalAlignment="Top" IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" IsClosable="False" Title="No tasks here" Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Severity="Informational" />
    </Grid>
</UserControl>
