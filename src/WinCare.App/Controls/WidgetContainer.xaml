<UserControl
    x:Class="WinCare.App.Controls.WidgetContainer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:plugins="using:WinCare.Application.Plugins">

    <StackPanel Spacing="12">
        <TextBlock Text="Active Plugin Widgets" Style="{StaticResource AppTitleTextStyle}" Foreground="{ThemeResource AccentTealBrush}" />
        <ItemsControl x:Name="WidgetsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="plugins:IPluginWidget">
                    <Border Background="{ThemeResource CardSurfaceBrush}"
                            BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="14,12" Margin="0,0,0,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Title, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource RowTitleTextStyle}" />
                                <TextBlock Text="{Binding StatusSummary, Mode=OneWay}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" Style="{StaticResource RowSecondaryTextStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{ThemeResource AccentTealSubtleBrush}" BorderBrush="{ThemeResource AccentTealBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusPill}" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Category}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentTealBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
