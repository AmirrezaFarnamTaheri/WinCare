<Page
    x:Class="WinCare.App.Views.Pages.AllToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinCare.App.Views.Pages"
    xmlns:vm="using:WinCare.App.ViewModels.Pages"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <Grid Padding="28,28,28,32" RowSpacing="18" KeyDown="Inspector_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="AllToolsPageTitle" Style="{StaticResource PageTitleTextStyle}" Text="Power tools" />
            <TextBlock MaxWidth="820" HorizontalAlignment="Left" Style="{StaticResource PageDescriptionTextStyle}"
                       Text="Find a specific task, browse by area, or return to tools you use often." />
        </StackPanel>

        <Grid x:Name="SearchFilterGrid" Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="190" />
                <ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ToolSearchBox" Header="Find a tool" MinHeight="44" TabIndex="1"
                     PlaceholderText="What do you want to do?"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="ToolSearch" AutomationProperties.Name="Search power tools">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="ToolSearch_FocusAccelerator" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <ComboBox x:Name="AreaFilter" Grid.Column="1" Header="Area" TabIndex="2" ItemsSource="{x:Bind ViewModel.AreaOptions, Mode=OneWay}" DisplayMemberPath="Label"
                      SelectedItem="{x:Bind ViewModel.SelectedAreaOption, Mode=TwoWay}" AutomationProperties.AutomationId="AreaFilter" AutomationProperties.Name="Filter power tools by area" />
            <ComboBox x:Name="SectionFilter" Grid.Column="2" Header="Section" TabIndex="3" ItemsSource="{x:Bind ViewModel.SectionOptions, Mode=OneWay}" DisplayMemberPath="Label"
                      SelectedItem="{x:Bind ViewModel.SelectedSectionOption, Mode=TwoWay}" AutomationProperties.AutomationId="SectionFilter" AutomationProperties.Name="Filter power tools by section" />
            <ComboBox x:Name="RiskFilter" Grid.Column="3" Header="Impact" TabIndex="4" AutomationProperties.HelpText="Impact describes how much a tool can change this PC: read-only, moderate, or permanent" ItemsSource="{x:Bind ViewModel.RiskOptions, Mode=OneWay}" DisplayMemberPath="Label"
                      SelectedItem="{x:Bind ViewModel.SelectedRiskOption, Mode=TwoWay}" AutomationProperties.AutomationId="RiskFilter" AutomationProperties.Name="Filter power tools by impact" />
            <CheckBox x:Name="ReadOnlyFilter" Grid.Column="4" Margin="0,26,0,0" VerticalAlignment="Center" Content="Read-only" TabIndex="5"
                      IsChecked="{x:Bind ViewModel.ReadOnlyOnly, Mode=TwoWay}" AutomationProperties.AutomationId="ReadOnlyFilter" AutomationProperties.Name="Show only read-only power tools" />
            <TextBlock x:Name="ResultCountText" Grid.Column="5" Margin="8,28,0,0" VerticalAlignment="Center" Style="{StaticResource RowSecondaryTextStyle}" TabIndex="6"
                       Text="{x:Bind ViewModel.ResultCountText, Mode=OneWay}" />
        </Grid>

        <SelectorBar x:Name="ToolTabs" Grid.Row="2" SelectionChanged="ToolTabs_SelectionChanged"
                     AutomationProperties.AutomationId="AllToolsTabs" AutomationProperties.Name="Power tools sections">
            <SelectorBarItem Text="Tools" AutomationProperties.Name="Tools" />
            <SelectorBarItem Text="Categories" AutomationProperties.Name="Categories" />
            <SelectorBarItem Text="Favorites" AutomationProperties.Name="Favorites" />
            <SelectorBarItem Text="Recent" AutomationProperties.Name="Recent" />
            <SelectorBarItem Text="Care plans" AutomationProperties.Name="Care plans" />
        </SelectorBar>

        <SplitView x:Name="DetailsSplitView" Grid.Row="3" DisplayMode="Inline" PanePlacement="Right" OpenPaneLength="420"
                   CompactPaneLength="0" IsPaneOpen="{x:Bind ViewModel.IsDetailsOpen, Mode=TwoWay}">
            <SplitView.Pane>
                <Border Margin="16,0,0,0" Padding="20" Background="{ThemeResource CardSurfaceBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Button x:Name="InspectorCloseButton" HorizontalAlignment="Right" Style="{StaticResource QuietButtonStyle}"
                                    Click="CloseInspector_Click" AutomationProperties.Name="Close tool details">
                                <FontIcon Glyph="&#xE711;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                            </Button>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind ViewModel.SelectedToolTitle, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.SelectedToolMetadata, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind ViewModel.SelectedToolSummary, Mode=OneWay}" />
                            </StackPanel>
                            <Border Padding="14" Background="{ThemeResource SurfaceSecondaryBrush}" CornerRadius="{StaticResource RadiusControl}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind ViewModel.Execution.ActionFlowTitle, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.Execution.ActionFlowDescription, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <InfoBar IsOpen="{x:Bind ViewModel.Execution.IsDestructiveTool, Mode=OneWay}" IsClosable="False" Severity="Error"
                                     Title="Permanent change" Message="This can make permanent changes. Read the preview before you apply it." />
                            <ToggleSwitch Header="I reviewed this change" OffContent="Not approved" OnContent="Approved" AutomationProperties.HelpText="Approval is required before a tool that makes permanent changes can run"
                                          IsEnabled="{x:Bind ViewModel.Execution.CanApproveReview, Mode=OneWay}"
                                          IsOn="{x:Bind ViewModel.Execution.IsReviewApproved, Mode=TwoWay}"
                                          Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.Execution.RequiresApprovalSwitch), Mode=OneWay}"
                                          AutomationProperties.Name="Approve the reviewed tool change" />
                            <Expander Header="Plan details and recovery" IsExpanded="True"
                                      Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.Execution.IsPresetTool), Mode=OneWay}"
                                      AutomationProperties.Name="Included care plan changes and recovery">
                                <TextBlock Style="{StaticResource PageDescriptionTextStyle}" IsTextSelectionEnabled="True"
                                           Text="{x:Bind ViewModel.Execution.PresetContents, Mode=OneWay}" />
                            </Expander>
                            <Expander x:Name="ParameterExpander" Header="Options" IsExpanded="True" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="CommandParameters" AutomationProperties.Name="Tool options" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource PrimaryActionButtonStyle}" Command="{x:Bind ViewModel.Execution.ExecuteSelectedToolCommand}"
                                        Content="{x:Bind ViewModel.Execution.PrimaryActionLabel, Mode=OneWay}" AccessKey="E"
                                        AutomationProperties.AutomationId="ExecuteSelectedTool" AutomationProperties.Name="Run or review selected tool" />
                                <Button Style="{StaticResource QuietButtonStyle}" Command="{x:Bind ViewModel.Execution.CancelSelectedToolCommand}"
                                        Content="{x:Bind ViewModel.Execution.CancelActionLabel, Mode=OneWay}"
                                        Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.Execution.IsExecuting), Mode=OneWay}"
                                        AutomationProperties.Name="Cancel selected tool operation" />
                            </StackPanel>
                            <Button HorizontalAlignment="Left" Style="{StaticResource QuietButtonStyle}" Click="FavoriteButton_Click"
                                    Content="{x:Bind ViewModel.FavoriteActionLabel, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.FavoriteActionLabel, Mode=OneWay}" />
                            <InfoBar IsOpen="{x:Bind ViewModel.Execution.IsExecutionResultOpen, Mode=OneWay}" IsClosable="False"
                                     Title="{x:Bind ViewModel.Execution.ExecutionTitle, Mode=OneWay}"
                                     Message="{x:Bind ViewModel.Execution.ExecutionMessage, Mode=OneWay}" />
                            <TextBlock Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.Execution.HasPackageInventory), Mode=OneWay}"
                                       Style="{StaticResource PageDescriptionTextStyle}" IsTextSelectionEnabled="True"
                                       Text="{x:Bind ViewModel.Execution.PackageInventoryText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="CommandPackageInventory" />
                            <TextBlock Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.Execution.HasExecutionResult), Mode=OneWay}"
                                       Style="{StaticResource TelemetryTextStyle}" IsTextSelectionEnabled="True"
                                       Text="{x:Bind ViewModel.Execution.ExecutionResultText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="CommandResultDetails" />
                            <Expander Header="Advanced details" IsExpanded="False" AutomationProperties.Name="Advanced tool details">
                                <TextBlock Style="{StaticResource TelemetryTextStyle}" IsTextSelectionEnabled="True"
                                           Text="{x:Bind ViewModel.SelectedToolTechnicalDetails, Mode=OneWay}" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </SplitView.Pane>

            <Grid>
                <Grid Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.IsCatalogTab), Mode=OneWay}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="16,10" ColumnSpacing="12" Background="{ThemeResource SurfaceSecondaryBrush}"
                          Visibility="{x:Bind local:AllToolsPage.InvertBoolToVisibility(ViewModel.IsCompactLayout), Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.5*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="Task" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}" Text="Category" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}" Text="Impact" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderTextStyle}" Text="Administrator access" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderTextStyle}" Text="Restart" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.VisibleTools, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTool, Mode=TwoWay}" SelectionMode="Single"
                              IsItemClickEnabled="True" ItemClick="ToolTable_ItemClick" AutomationProperties.AutomationId="AllToolsTable" AutomationProperties.Name="Power tools results">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="AutomationProperties.Name" Value="{Binding ToolAccessibleName}" /></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToolRowViewModel">
                                <Grid Padding="16,14" ColumnSpacing="12">
                                    <Grid Visibility="{x:Bind local:AllToolsPage.InvertBoolToVisibility(IsCompact), Mode=OneWay}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.5*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" /><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Summary}" /></StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind CategoryText}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Risk}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind AdministratorAccess}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Restart}" />
                                    </Grid>
                                    <StackPanel Spacing="4" Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(IsCompact), Mode=OneWay}">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Summary}" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind CategoryText}" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Risk}" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind AdministratorText}" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind RestartText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <InfoBar Grid.Row="1" Margin="12" VerticalAlignment="Top" IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                             IsClosable="False" Severity="Informational" Title="No matching tools" Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" />
                </Grid>

                <ScrollViewer Background="{ThemeResource PageBackgroundBrush}" VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.IsCategoryTab), Mode=OneWay}">
                    <StackPanel Spacing="14"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Browse by category" />
                        <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Choose an area to browse related tools." />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryCards, Mode=OneWay}"><ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToolCategoryViewModel">
                                <Button Margin="0,0,0,8" Padding="18" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource QuietButtonStyle}" Tag="{x:Bind Key}" Click="CategoryCard_Click" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Section}" /><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Area}" /><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ExampleSummary}" /></StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind CountText}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Background="{ThemeResource PageBackgroundBrush}" VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.IsPresetTab), Mode=OneWay}">
                    <StackPanel Spacing="16"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Care plans" />
                        <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Review a group of related changes together. You can see every step before applying it." />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PresetCards, Mode=OneWay}"><ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PresetCardViewModel">
                                <Border Margin="0,0,0,12" Padding="20" Style="{StaticResource SurfaceBorderStyle}">
                                    <StackPanel Spacing="8"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind Title}" /><TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind Description}" /><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ImpactText}" /><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind RecoveryText}" />
                                        <Button HorizontalAlignment="Left" Style="{StaticResource QuietButtonStyle}" Content="Review plan" Tag="{x:Bind Id}" Click="ReviewPresetButton_Click" AutomationProperties.Name="{x:Bind InspectAccessibleName}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </SplitView>
    </Grid>
</Page>
