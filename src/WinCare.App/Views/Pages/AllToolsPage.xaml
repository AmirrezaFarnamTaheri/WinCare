<Page
    x:Class="WinCare.App.Views.Pages.AllToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinCare.App.Views.Pages"
    xmlns:views="using:WinCare.App.Views"
    xmlns:vm="using:WinCare.App.ViewModels.Pages"
    xmlns:converters="using:WinCare.App.Converters"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <converters:ThemeResourceBrushConverter x:Key="ThemeResourceBrushConverter" />
    </Page.Resources>
    <Grid Padding="28,28,28,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="AllToolsPageTitle" Style="{StaticResource PageTitleTextStyle}" Text="All tools" />
            <TextBlock MaxWidth="820" HorizontalAlignment="Left" Style="{StaticResource PageDescriptionTextStyle}" Text="Find the right tool, inspect its impact, then choose your next step. Search by name, purpose, or the part of Windows you want to work on." />
        </StackPanel>

        <SelectorBar
            x:Name="ToolTabs"
            Grid.Row="2"
            SelectionChanged="ToolTabs_SelectionChanged"
            AutomationProperties.AutomationId="AllToolsTabs"
            AutomationProperties.Name="All tools sections">
            <SelectorBarItem Text="Commands" AutomationProperties.AutomationId="ToolsTabCommands" AutomationProperties.Name="Commands" />
            <SelectorBarItem Text="Categories" AutomationProperties.AutomationId="ToolsTabCategories" AutomationProperties.Name="Categories" />
            <SelectorBarItem Text="Favorites" AutomationProperties.AutomationId="ToolsTabFavorites" AutomationProperties.Name="Favorites" />
            <SelectorBarItem Text="Recent" AutomationProperties.AutomationId="ToolsTabRecent" AutomationProperties.Name="Recent" />
            <SelectorBarItem Text="Presets" AutomationProperties.AutomationId="ToolsTabPresets" AutomationProperties.Name="Presets" />
        </SelectorBar>

        <Grid x:Name="SearchFilterGrid" Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="ToolSearchBox"
                Header="Find a tool"
                MinHeight="44"
                PlaceholderText="What do you want to inspect or change?"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTipService.ToolTip="Filter catalog tools by name or description (Ctrl+F)"
                AutomationProperties.AutomationId="ToolSearch"
                AutomationProperties.Name="Search all tools">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="F"
                                         Invoked="ToolSearch_FocusAccelerator" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <ComboBox
                Grid.Column="1"
                Header="Area"
                ItemsSource="{x:Bind ViewModel.AreaOptions, Mode=OneWay}"
                DisplayMemberPath="Label"
                SelectedItem="{x:Bind ViewModel.SelectedAreaOption, Mode=TwoWay}"
                AutomationProperties.AutomationId="AreaFilter"
                AutomationProperties.Name="Filter tools by area" />
            <ComboBox
                Grid.Column="2"
                Header="Risk"
                ItemsSource="{x:Bind ViewModel.RiskOptions, Mode=OneWay}"
                DisplayMemberPath="Label"
                SelectedItem="{x:Bind ViewModel.SelectedRiskOption, Mode=TwoWay}"
                AutomationProperties.AutomationId="RiskFilter"
                AutomationProperties.Name="Filter tools by risk" />
            <CheckBox
                Grid.Column="3"
                Margin="0,26,0,0"
                VerticalAlignment="Center"
                Content="Read-only"
                IsChecked="{x:Bind ViewModel.ReadOnlyOnly, Mode=TwoWay}"
                AutomationProperties.AutomationId="ReadOnlyFilter"
                AutomationProperties.Name="Show read-only tools only" />
            <TextBlock
                Grid.Column="4"
                Margin="8,28,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource RowSecondaryTextStyle}"
                Text="{x:Bind ViewModel.ResultCountText, Mode=OneWay}" />
        </Grid>

        <SplitView
            x:Name="DetailsSplitView"
            Grid.Row="3"
            DisplayMode="Inline"
            PanePlacement="Right"
            OpenPaneLength="390"
            CompactPaneLength="0"
            IsPaneOpen="{x:Bind ViewModel.IsDetailsOpen, Mode=TwoWay}">
            <SplitView.Pane>
                <Border
                    KeyDown="Inspector_KeyDown"
                    Margin="16,0,0,0"
                    Padding="20"
                    Background="{ThemeResource CardSurfaceBrush}"
                    BorderBrush="{ThemeResource AccentTealBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="{StaticResource RadiusControl}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Button x:Name="InspectorCloseButton" HorizontalAlignment="Right" Style="{StaticResource QuietButtonStyle}" Click="CloseInspector_Click" AutomationProperties.Name="Close tool details" ToolTipService.ToolTip="Close tool details (Esc)">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind ViewModel.SelectedToolTitle, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.SelectedToolMetadata, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind ViewModel.SelectedToolSummary, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Padding="14"
                                Background="{ThemeResource SurfaceSecondaryBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusControl}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource AccentTealBrush}" CornerRadius="2" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind ViewModel.Execution.ActionFlowTitle, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.Execution.ActionFlowDescription, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.Execution.IsDestructiveTool, Mode=OneWay}"
                                IsClosable="False"
                                Severity="Error"
                                Title="Irreversible change"
                                Message="This command makes irreversible system changes. A preflight preview and explicit review approval are strictly required before execution."
                                AutomationProperties.AutomationId="DestructiveToolWarning"
                                AutomationProperties.Name="Destructive tool warning" />
                            <ToggleSwitch
                                Header="Approve this change"
                                OffContent="Preview only"
                                OnContent="Review approved"
                                IsEnabled="{x:Bind ViewModel.Execution.CanApproveReview, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.Execution.IsReviewApproved, Mode=TwoWay}"
                                Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.Execution.RequiresApprovalSwitch), Mode=OneWay}"
                                AutomationProperties.AutomationId="ReviewApprovedToggle"
                                AutomationProperties.Name="Approve mutating command execution after preview" />
                            <Expander Header="Included changes and recovery" IsExpanded="True" AutomationProperties.Name="Included preset changes and recovery"
                                Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.Execution.IsPresetTool), Mode=OneWay}">
                                <TextBlock Style="{StaticResource PageDescriptionTextStyle}" IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.Execution.PresetContents, Mode=OneWay}" />
                            </Expander>
                            <Expander
                                Header="Advanced Parameters (JSON)"
                                IsExpanded="False"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Command parameters JSON">
                                <TextBox
                                    MinHeight="120"
                                    AcceptsReturn="True"
                                    FontFamily="{StaticResource TelemetryFontFamily}"
                                    FontSize="12"
                                    Header="JSON parameters"
                                    PlaceholderText="{}"
                                    Text="{x:Bind ViewModel.Execution.ParameterJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="NoWrap"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    AutomationProperties.AutomationId="CommandParameterJson"
                                    AutomationProperties.Name="Command parameters as JSON" />
                            </Expander>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.Execution.ExecuteSelectedToolCommand}"
                                    Content="{x:Bind ViewModel.Execution.PrimaryActionLabel, Mode=OneWay}"
                                    AutomationProperties.AutomationId="ExecuteSelectedTool"
                                    AutomationProperties.Name="Run or review the selected tool" />
                                <ProgressRing
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind ViewModel.Execution.IsExecuting, Mode=OneWay}"
                                    Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.Execution.IsExecuting), Mode=OneWay}"
                                    AutomationProperties.Name="Selected tool is running" />
                                <Button
                                    Grid.Row="1"
                                    Command="{x:Bind ViewModel.Execution.CancelSelectedToolCommand}"
                                    Content="{x:Bind ViewModel.Execution.CancelActionLabel, Mode=OneWay}"
                                    Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.Execution.IsExecuting), Mode=OneWay}"
                                    AutomationProperties.AutomationId="CancelSelectedTool"
                                    AutomationProperties.Name="Cancel active tool operation" />
                                <ToggleButton
                                    x:Name="FavoriteToggleButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    MinHeight="44" MinWidth="44" HorizontalAlignment="Left"
                                    Content="&#xE735;"
                                    FontFamily="Segoe Fluent Icons"
                                    IsChecked="{x:Bind ViewModel.IsSelectedToolFavorite, Mode=OneWay}"
                                    Click="FavoriteButton_Click"
                                    ToolTipService.ToolTip="Toggle favorite bookmark"
                                    AutomationProperties.AutomationId="FavoriteSelectedTool"
                                    AutomationProperties.Name="Add or remove selected tool from favorites" />
                            </Grid>
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.Execution.IsExecutionSuccess, Mode=OneWay}"
                                IsClosable="False"
                                Severity="Success"
                                Title="{x:Bind ViewModel.Execution.ExecutionTitle, Mode=OneWay}"
                                Message="{x:Bind ViewModel.Execution.ExecutionMessage, Mode=OneWay}" />
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.Execution.IsExecutionError, Mode=OneWay}"
                                IsClosable="False"
                                Severity="Error"
                                Title="{x:Bind ViewModel.Execution.ExecutionTitle, Mode=OneWay}"
                                Message="{x:Bind ViewModel.Execution.ExecutionMessage, Mode=OneWay}" />
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.Execution.IsExecutionCancelled, Mode=OneWay}"
                                IsClosable="False"
                                Severity="Warning"
                                Title="{x:Bind ViewModel.Execution.ExecutionTitle, Mode=OneWay}"
                                Message="{x:Bind ViewModel.Execution.ExecutionMessage, Mode=OneWay}" />
                            <Expander Header="Evidence summary" IsExpanded="True" AutomationProperties.Name="Plain-language command evidence" Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.Execution.HasPackageInventory), Mode=OneWay}">
                                <TextBox Text="{x:Bind ViewModel.Execution.PackageInventoryText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="360" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Command evidence summary" />
                            </Expander>
                            <Expander
                                Header="Technical result"
                                IsExpanded="{x:Bind ViewModel.Execution.IsExecutionResultOpen, Mode=TwoWay}"
                                Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.Execution.HasExecutionResult), Mode=OneWay}"
                                AutomationProperties.AutomationId="CommandResultDetails"
                                AutomationProperties.Name="Structured command result">
                                <TextBox
                                    MinHeight="160"
                                    MaxHeight="360"
                                    AcceptsReturn="True"
                                    FontFamily="{StaticResource TelemetryFontFamily}"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.Execution.ExecutionResultText, Mode=OneWay}"
                                    TextWrapping="NoWrap"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    AutomationProperties.Name="Structured command output" />
                            </Expander>
                            <Expander Header="Advanced details" AutomationProperties.Name="Advanced tool details">
                                <TextBlock
                                    FontFamily="{StaticResource TelemetryFontFamily}"
                                    FontSize="12"
                                    IsTextSelectionEnabled="True"
                                    LineHeight="18"
                                    Padding="12"
                                    Text="{x:Bind ViewModel.SelectedToolTechnicalDetails, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </SplitView.Pane>

            <Grid>
              <Grid Visibility="{x:Bind local:AllToolsPage.InvertBoolToVisibility(ViewModel.IsPresetTab), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    x:Name="TableHeader"
                    Height="48"
                    Padding="16,0"
                    ColumnSpacing="12"
                    Background="{ThemeResource SurfaceSecondaryBrush}"
                    Visibility="{x:Bind views:LayoutVisibility.InvertBoolToVisibility(ViewModel.IsCompactLayout), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="Command"
                               ToolTipService.ToolTip="Command name and unique identifier" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}" Text="Category"
                               ToolTipService.ToolTip="Functional area or system domain" />
                    <TextBlock x:Name="RiskHeader" Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}" Text="Risk"
                               ToolTipService.ToolTip="Impact level: Read-only, Low, Elevated, or Mutating" />
                    <TextBlock x:Name="AdministratorHeader" Grid.Column="3" Style="{StaticResource ColumnHeaderTextStyle}" Text="Administrator access"
                               ToolTipService.ToolTip="Whether elevated privileges are required" />
                    <TextBlock x:Name="RestartHeader" Grid.Column="4" Style="{StaticResource ColumnHeaderTextStyle}" Text="Restart"
                               ToolTipService.ToolTip="Whether a system restart is required after execution" />
                    <TextBlock x:Name="StatusHeader" Grid.Column="5" Style="{StaticResource ColumnHeaderTextStyle}" Text="Status"
                               ToolTipService.ToolTip="Migration readiness: Ready, Pending migration, or Not ready"
                               AutomationProperties.AutomationId="StatusColumnHeader" />
                </Grid>
                <InfoBar
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    VerticalAlignment="Top"
                    IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Nothing to show"
                    Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" />
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.VisibleTools, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedTool, Mode=TwoWay}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="ToolTable_ItemClick"
                    AutomationProperties.AutomationId="AllToolsTable"
                    AutomationProperties.Name="All WinCare tools">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="76" />
                            <!-- F-032: selectable rows must announce the tool, not the view-model type name. -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding ToolAccessibleName}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolRowViewModel">
                            <Grid Padding="16,14" ColumnSpacing="12">
                                <Grid
                                    Visibility="{x:Bind local:AllToolsPage.InvertBoolToVisibility(IsCompact), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" FontFamily="{StaticResource TelemetryFontFamily}" Text="{x:Bind Id}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Area}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Risk}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind AdministratorAccess}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Restart}" />
                                    <ContentControl Grid.Column="5" VerticalAlignment="Center" Template="{StaticResource StatusPillTemplate}" Content="{x:Bind StatusPillLabel}" Background="{x:Bind StatusPillBackgroundResourceKey, Mode=OneWay, Converter={StaticResource ThemeResourceBrushConverter}}" Foreground="{x:Bind StatusPillForegroundResourceKey, Mode=OneWay, Converter={StaticResource ThemeResourceBrushConverter}}" />
                                </Grid>
                                <StackPanel
                                    Spacing="4"
                                    Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(IsCompact), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" FontFamily="{StaticResource TelemetryFontFamily}" Text="{x:Bind Id}" />
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Area}" />
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Risk}" />
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind AdministratorText}" />
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind RestartText}" />
                                    <ContentControl HorizontalAlignment="Left" Margin="0,4,0,0" Template="{StaticResource StatusPillTemplate}" Content="{x:Bind StatusPillLabel}" AutomationProperties.Name="{x:Bind StatusPillLabel}" Background="{x:Bind StatusPillBackgroundResourceKey, Mode=OneWay, Converter={StaticResource ThemeResourceBrushConverter}}" Foreground="{x:Bind StatusPillForegroundResourceKey, Mode=OneWay, Converter={StaticResource ThemeResourceBrushConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
              </Grid>
                <ScrollViewer
                    Grid.RowSpan="2"
                    Canvas.ZIndex="10"
                    Background="{ThemeResource PageBackgroundBrush}"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind local:AllToolsPage.BoolToVisibility(ViewModel.IsPresetTab), Mode=OneWay}">
                    <StackPanel Spacing="16" Padding="0,0,4,20">
                        <StackPanel Spacing="5">
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Curated care plans" />
                            <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Choose a plan to inspect every included rule. WinCare previews the current targets and impact before any approval is available." />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PresetCards, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PresetCardViewModel">
                                    <Border MinHeight="180" Margin="0,0,0,12" Padding="20" Style="{StaticResource SurfaceBorderStyle}">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind Title}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource TelemetryTextStyle}" Foreground="{ThemeResource AccentTealBrush}" Text="{x:Bind RuleCountText}" />
                                            </Grid>
                                            <TextBlock Grid.Row="1" Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind Description}" />
                                            <StackPanel Grid.Row="2" Spacing="5">
                                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ImpactText}" />
                                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind RecoveryText}" />
                                            </StackPanel>
                                            <Button Grid.Row="3" HorizontalAlignment="Left" Style="{StaticResource QuietButtonStyle}" Content="Inspect plan" Tag="{x:Bind Id}" Click="ReviewPresetButton_Click" AutomationProperties.Name="{x:Bind InspectAccessibleName}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </SplitView>
    </Grid>
</Page>
