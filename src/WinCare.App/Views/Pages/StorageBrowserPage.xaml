<Page
    x:Class="WinCare.App.Views.Pages.StorageBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinCare.App.Controls"
    xmlns:storage="using:WinCare.Application.Storage"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <Grid x:Name="PageLayout" Padding="32,28,32,28" RowSpacing="16" MaxWidth="1320" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:PageHeaderControl Title="Files &amp; storage"
            Description="Find files, check drive space, and inspect folders. Browsing and size checks never change your files." />

        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Padding="16">
            <Grid x:Name="DriveLayout" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="4" MinWidth="240">
                    <TextBlock Text="Drive" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox x:Name="DrivePicker" ItemsSource="{x:Bind Drives, Mode=OneWay}"
                              DisplayMemberPath="Label" MinHeight="44" HorizontalAlignment="Stretch"
                              SelectionChanged="DrivePicker_SelectionChanged"
                              AutomationProperties.Name="Choose a drive" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="DriveSpaceText" Style="{StaticResource RowSecondaryTextStyle}"
                               Text="Select a drive to see free space." />
                    <ProgressBar x:Name="DriveUsageBar" Maximum="100" Value="0" MinHeight="6"
                                 AutomationProperties.Name="Drive space used, percent" />
                </StackPanel>
                <Button x:Name="OpenExplorerButton" Grid.Column="2" Content="Open in Explorer" Click="OpenLocation_Click"
                        Style="{StaticResource QuietButtonStyle}" VerticalAlignment="Center"
                        AutomationProperties.Name="Open the current folder in Windows File Explorer" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" RowSpacing="8">
            <Button x:Name="BackButton" Content="Back" Click="Back_Click" IsEnabled="False"
                    Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="Previous folder" />
            <Button x:Name="UpButton" Grid.Column="1" Content="Up" Click="Up_Click"
                    Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="Parent folder" />
            <TextBox x:Name="PathInput" Grid.Column="2" MinHeight="44"
                     PlaceholderText="Enter a folder path" KeyDown="PathInput_KeyDown"
                     AutomationProperties.Name="Current folder path" AutomationProperties.AutomationId="StoragePath" />
            <Button Grid.Column="3" Content="Go" Click="Go_Click"
                    Style="{StaticResource PrimaryActionButtonStyle}" AutomationProperties.Name="Browse this folder" />
        </Grid>

        <Grid x:Name="SearchActions" Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBox x:Name="FilterInput" PlaceholderText="Filter files in this folder"
                     MinHeight="44" TextChanged="FilterInput_TextChanged"
                     AutomationProperties.Name="Filter files and folders by name" />
            <Button x:Name="ScanButton" Grid.Column="1" Content="Measure folder" Click="Scan_Click"
                    Style="{StaticResource QuietButtonStyle}"
                    AutomationProperties.Name="Calculate size of current folder with a bounded read-only scan" />
            <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Click="Refresh_Click"
                    Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="Reload folder" />
            <Button x:Name="CopyPathButton" Grid.Column="3" Content="Copy path" Click="CopyPath_Click"
                    Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="Copy selected file or folder path" />
        </Grid>

        <InfoBar x:Name="NoticeBar" Grid.Row="4" IsOpen="False" IsClosable="True" Severity="Informational"
                 Title="Files &amp; storage" AutomationProperties.LiveSetting="Polite" />

        <Border Grid.Row="5" Style="{StaticResource SurfaceBorderStyle}">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Background="{ThemeResource SurfaceSecondaryBrush}" Padding="16,12"
                      ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock x:Name="FolderTitle" Text="Folder contents" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock x:Name="CountText" Grid.Column="1" Text="0 items"
                               Style="{StaticResource RowSecondaryTextStyle}" VerticalAlignment="Center" />
                </Grid>
                <ListView x:Name="EntriesList" Grid.Row="1"
                          ItemsSource="{x:Bind VisibleEntries, Mode=OneWay}" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="EntriesList_ItemClick"
                          AutomationProperties.Name="Files and folders">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="68" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="storage:StorageBrowserItem">
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,10" ColumnSpacing="14"
                                  AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Border Background="{ThemeResource AccentChromeSubtleBrush}" Width="40" Height="40"
                                        CornerRadius="{StaticResource RadiusControl}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="19"
                                              Foreground="{ThemeResource AccentChromeBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleTextStyle}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind Kind}" Style="{StaticResource RowSecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind SizeLabel}" Style="{StaticResource RowTitleTextStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind ModifiedLabel}" Style="{StaticResource RowSecondaryTextStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <Expander x:Name="HotspotsExpander" Grid.Row="6" Header="Largest subfolders found" IsExpanded="False"
                  AutomationProperties.Name="Largest subfolders found"
                  Visibility="Collapsed">
            <ListView Height="196" ItemsSource="{x:Bind LargestFolders, Mode=OneWay}"
                      IsItemClickEnabled="True" SelectionMode="None" ItemClick="Hotspot_ItemClick"
                      AutomationProperties.Name="Largest subfolders in the latest read-only scan">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="storage:StorageHotspot">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="12,8"
                              ColumnSpacing="12" RowSpacing="7"
                              AutomationProperties.Name="{x:Bind AccessibleName}">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind SizeLabel}"
                                       Style="{StaticResource RowSecondaryTextStyle}" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                                         Value="{x:Bind SharePercent}" MinHeight="5"
                                         AutomationProperties.Name="Share of measured folder contents" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Expander>
        <Grid Grid.Row="7" ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <ProgressRing x:Name="ScanProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed"
                          AutomationProperties.Name="Working" />
            <TextBlock x:Name="ScanSummaryText" Grid.Column="1" Text="Select a folder, or measure its size to see what it contains."
                       Style="{StaticResource RowSecondaryTextStyle}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
