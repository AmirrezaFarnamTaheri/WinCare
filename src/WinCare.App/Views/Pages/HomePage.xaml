<Page
    x:Class="WinCare.App.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinCare.App.Controls"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" Padding="32,28,32,36" RowSpacing="28" MaxWidth="1440" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <controls:PageHeaderControl
                Title="Home"
                Description="See what needs attention and get where you need to go." />

            <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Background="{ThemeResource HeroBackgroundBrush}">
                <Grid x:Name="HeroLayout" ColumnSpacing="28" RowSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="12" MaxWidth="760">
                        <Border Background="{ThemeResource AccentChromeSubtleBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusPill}"
                                Padding="8,3"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="NATIVE PROBE ENGINE · READY"
                                           FontFamily="{StaticResource TelemetryFontFamily}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentChromeBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource HeroTitleTextStyle}" Text="{x:Bind ViewModel.CheckupTitle, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind ViewModel.CheckupSummary, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="RunCheckupButton" Click="RunCheckupButton_Click" Style="{StaticResource PrimaryActionButtonStyle}" Content="Open checkup" AccessKey="O" AutomationProperties.AutomationId="HomeRunCheckup" AutomationProperties.Name="Open checkup"/>
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="HeroDivider" Grid.Column="1" Width="1" Background="{ThemeResource BorderSubtleBrush}" VerticalAlignment="Stretch"/>
                    <StackPanel x:Name="HeroStats" Grid.Column="2" Spacing="6" MinWidth="170" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MetricTextStyle}" Text="{x:Bind ViewModel.CheckupCoverageText, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Checkup coverage"/>
                        <TextBlock Style="{StaticResource TelemetryTextStyle}" FontSize="10" Text="READ-ONLY EVIDENCE" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Spacing="12"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Common care"/>
                <Grid x:Name="RecommendationsGrid" ColumnSpacing="14" RowSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button x:Name="CleanupRecommendation" Style="{StaticResource RecommendationButtonStyle}" Click="OpenCleanup_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open storage cleanup">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileStyle}"><FontIcon Glyph="&#xE74D;" FontSize="20" Foreground="{ThemeResource AccentChromeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/></Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Clean up storage"/>
                                    <Border Background="{ThemeResource AccentChromeSubtleBrush}" Padding="6,1" CornerRadius="{StaticResource RadiusPill}" VerticalAlignment="Center">
                                        <TextBlock Text="NTFS / TEMP" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource AccentChromeBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Free up space and see what's taking room."/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </Button>
                    <Button x:Name="StartupRecommendation" Grid.Column="1" Style="{StaticResource RecommendationButtonStyle}" Click="OpenStartup_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open apps and startup">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileStyle}"><FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{ThemeResource AccentChromeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/></Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Apps &amp; startup"/>
                                    <Border Background="{ThemeResource AccentChromeSubtleBrush}" Padding="6,1" CornerRadius="{StaticResource RadiusPill}" VerticalAlignment="Center">
                                        <TextBlock Text="RUN / TASKS" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource AccentChromeBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Manage installed apps and what starts with Windows."/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NetworkRecommendation" Grid.Column="2" Style="{StaticResource RecommendationButtonStyle}" Click="OpenNetwork_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open network and updates">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileStyle}"><FontIcon Glyph="&#xE701;" FontSize="20" Foreground="{ThemeResource AccentChromeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/></Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Network &amp; updates"/>
                                    <Border Background="{ThemeResource AccentChromeSubtleBrush}" Padding="6,1" CornerRadius="{StaticResource RadiusPill}" VerticalAlignment="Center">
                                        <TextBlock Text="DNS / WUA" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource AccentChromeBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Check connectivity, DNS, and Windows Update."/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
            <Grid x:Name="OverviewGrid" Grid.Row="3" ColumnSpacing="18" RowSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="System at a glance"/>
                            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="The latest result from each Checkup area."/>
                        </StackPanel>
                        <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_System_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open system checkup details">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Windows &amp; hardware"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.SystemStatus, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Storage_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open storage cleanup">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Storage"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.StorageStatus, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Security_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open security care">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Security"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.SecurityStatus, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Updates_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open network and update care">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Windows Update"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.UpdatesStatus, Mode=OneWay}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
                <Border x:Name="RecentActivityCard" Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Style="{StaticResource IconTileStyle}"><FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource AccentChromeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/></Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource SectionHeaderTextStyle}" Text="Recent activity" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind ViewModel.RecentActivityTitle, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind ViewModel.RecentActivitySummary, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="11" Text="{x:Bind ViewModel.ActivityStatus, Mode=OneWay}"/>
                        <Button Click="ViewActivityButton_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Content="Open activity" AutomationProperties.Name="Open activity history"/>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Row="4" Spacing="12"><InfoBar x:Name="PluginWidgetError" IsOpen="False" IsClosable="True" Severity="Warning" Title="Extension widgets couldn't load"/><controls:WidgetContainer x:Name="PluginWidgets" Visibility="Collapsed"/></StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
