<Page
    x:Class="WinCare.App.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinCare.App.Controls"
    xmlns:local="using:WinCare.App.Views.Pages"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" Padding="32,28,32,36" RowSpacing="28" MaxWidth="1320" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Workspace Header -->
            <controls:PageHeaderControl
                Title="System Nexus"
                Description="Central intelligence hub for hardware diagnostics, high-throughput transfers, and system care." />

            <!-- Bento Hero: Diagnostic Telemetry Status -->
            <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Background="{ThemeResource HeroBackgroundBrush}" Padding="24">
                <Grid x:Name="HeroLayout" ColumnSpacing="28" RowSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="12" MaxWidth="760">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AccentChromeSubtleBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="TELEMETRY SCANNER" FontFamily="Cascadia Code" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentChromeBrush}"/>
                            </Border>
                            <TextBlock Text="SYSTEM PROBE STATUS" Style="{StaticResource FieldLabelTextStyle}"
                                       FontFamily="Cascadia Code" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HeroTitleTextStyle}" Text="{x:Bind ViewModel.CheckupTitle, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind ViewModel.CheckupSummary, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button x:Name="RunCheckupButton" Click="RunCheckupButton_Click"
                                    Style="{StaticResource PrimaryActionButtonStyle}" Content="Open checkup"
                                    AccessKey="O" AutomationProperties.AutomationId="HomeRunCheckup"
                                    AutomationProperties.Name="Open checkup"/>
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="HeroDivider" Grid.Column="1" Width="1" Background="{ThemeResource BorderSubtleBrush}" VerticalAlignment="Stretch"/>
                    <StackPanel x:Name="HeroStats" Grid.Column="2" Spacing="6" MinWidth="170" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MetricTextStyle}" FontFamily="Cascadia Code"
                                   Text="{x:Bind ViewModel.CheckupCoverageText, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Checkup coverage"/>
                        <TextBlock Style="{StaticResource TelemetryTextStyle}" FontFamily="Cascadia Code" FontSize="11"
                                   Text="4 Read-Only Probes" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bento Subsystems: Quick Actions Matrix -->
            <StackPanel Grid.Row="2" Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Quick actions" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="{ThemeResource SurfaceSecondaryBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="6 Unified Nodes" FontSize="11" FontFamily="Cascadia Code" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>

                <Grid x:Name="RecommendationsGrid" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <!-- Storage Reclamation -->
                    <Button x:Name="CleanupRecommendation" Style="{StaticResource RecommendationButtonStyle}"
                            Click="OpenCleanup_Click" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="Open storage cleanup">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileStyle}">
                                <FontIcon Glyph="&#xE74D;" FontSize="20" Foreground="{ThemeResource AccentChromeBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Clean up storage"/>
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Reclaim temporary files, crash dumps, and disk cache."/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </Button>

                    <!-- Startup & Execution Policy -->
                    <Button x:Name="StartupRecommendation" Grid.Column="1" Style="{StaticResource RecommendationButtonStyle}"
                            Click="OpenStartup_Click" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="Open apps and startup">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileStyle}">
                                <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{ThemeResource AccentChromeBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Apps &amp; startup"/>
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Manage installed packages and background launch impact."/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </Button>

                    <!-- Network & Windows Update -->
                    <Button x:Name="NetworkRecommendation" Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource RecommendationButtonStyle}" Click="OpenNetwork_Click"
                            HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open network and updates">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileStyle}">
                                <FontIcon Glyph="&#xE701;" FontSize="20" Foreground="{ThemeResource AccentChromeBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Network &amp; updates"/>
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Verify connectivity, DNS resolution, and Windows Update health."/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </Button>

                    <!-- BitTorrent & High-Throughput Transfers Hub -->
                    <Button x:Name="DownloadsRecommendation" Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource RecommendationButtonStyle}" Click="OpenDownloads_Click"
                            HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="HomeDownloads"
                            AutomationProperties.Name="Open Downloads and manage queued transfers">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileStyle}">
                                <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource AccentChromeBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Transfers &amp; Swarms"/>
                                    <Border Background="{ThemeResource AccentChromeSubtleBrush}" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="BT / HTTP" FontFamily="Cascadia Code" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentChromeBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}"
                                           Text="BitTorrent P2P swarm engine with sparse allocation and direct HTTP."/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </Button>

                    <!-- Storage Analysis & Files -->
                    <Button x:Name="FilesRecommendation" Grid.Row="2" Grid.Column="0"
                            Style="{StaticResource RecommendationButtonStyle}" Click="OpenFiles_Click"
                            HorizontalContentAlignment="Stretch" AutomationProperties.Name="Browse files and storage">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Style="{StaticResource IconTileStyle}">
                                <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource AccentChromeBrush}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Files &amp; storage" Style="{StaticResource RowTitleTextStyle}" />
                                <TextBlock Text="Browse volumes, find largest directories, and measure allocations." Style="{StaticResource RowSecondaryTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Button>

                    <!-- Process Telemetry -->
                    <Button x:Name="ProcessesRecommendation" Grid.Row="2" Grid.Column="1"
                            Style="{StaticResource RecommendationButtonStyle}" Click="OpenProcesses_Click"
                            HorizontalContentAlignment="Stretch" AutomationProperties.Name="Monitor running processes">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Style="{StaticResource IconTileStyle}">
                                <FontIcon Glyph="&#xE9CE;" FontSize="20" Foreground="{ThemeResource AccentChromeBrush}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Processes" Style="{StaticResource RowTitleTextStyle}" />
                                <TextBlock Text="Inspect kernel threads, working set memory, and CPU utilization." Style="{StaticResource RowSecondaryTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- Pinned Favorite Power Tools -->
                <StackPanel x:Name="FavoriteToolsPanel" Spacing="8" Visibility="Collapsed" Margin="0,16,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,4">
                        <TextBlock Text="Your saved tools" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Button Grid.Column="1" Content="See all favorites" Style="{StaticResource QuietButtonStyle}"
                                Click="SeeFavorites_Click" AutomationProperties.Name="Open all favorite power tools" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind FavoriteTools, Mode=OneWay}"
                                  AutomationProperties.Name="Favorite power tools">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:HomeFavoriteTool">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource StatusRowButtonStyle}" Click="FavoriteTool_Click"
                                        Tag="{x:Bind}" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border Background="{ThemeResource AccentChromeSubtleBrush}" Width="40" Height="40"
                                                CornerRadius="{StaticResource RadiusControl}">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="18"
                                                      Foreground="{ThemeResource AccentChromeBrush}"
                                                      AutomationProperties.AccessibilityView="Raw" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowTitleTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource RowSecondaryTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Bento Bottom: Telemetry Matrix & Audit Stream -->
            <Grid x:Name="OverviewGrid" Grid.Row="3" ColumnSpacing="18" RowSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Subsystem Diagnostics Status -->
                <Border Style="{StaticResource DashboardCardStyle}" Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Subsystems Diagnostics"/>
                            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Latest recorded health telemetry across core Windows subsystems."/>
                        </StackPanel>
                        <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_System_Click"
                                HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open system checkup details">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentChromeBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Windows &amp; hardware"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}"
                                           FontFamily="Cascadia Code" FontWeight="SemiBold"
                                           Text="{x:Bind ViewModel.SystemStatus, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Storage_Click"
                                HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open storage cleanup">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentChromeBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Storage subsystems"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}"
                                           FontFamily="Cascadia Code" FontWeight="SemiBold"
                                           Text="{x:Bind ViewModel.StorageStatus, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Security_Click"
                                HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open security care">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentChromeBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Security &amp; Defender"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}"
                                           FontFamily="Cascadia Code" FontWeight="SemiBold"
                                           Text="{x:Bind ViewModel.SecurityStatus, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Updates_Click"
                                HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open network and update care">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentChromeBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Windows Update status"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}"
                                           FontFamily="Cascadia Code" FontWeight="SemiBold"
                                           Text="{x:Bind ViewModel.UpdatesStatus, Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Audit Stream & Activity -->
                <Border x:Name="RecentActivityCard" Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Style="{StaticResource IconTileStyle}">
                                <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource AccentChromeBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource SectionHeaderTextStyle}" Text="Audit stream" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind ViewModel.RecentActivityTitle, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource PageDescriptionTextStyle}" FontFamily="Cascadia Code" FontSize="12"
                                   Text="{x:Bind ViewModel.RecentActivitySummary, Mode=OneWay}"/>
                        <Border Background="{ThemeResource SurfaceSecondaryBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" FontFamily="Cascadia Code" FontSize="11"
                                       Text="{x:Bind ViewModel.ActivityStatus, Mode=OneWay}"/>
                        </Border>
                        <Button Click="ViewActivityButton_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left"
                                Content="Open audit journal" AutomationProperties.Name="Open activity history"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Extension Widgets -->
            <StackPanel Grid.Row="4" Spacing="12">
                <InfoBar x:Name="PluginWidgetError" IsOpen="False" IsClosable="True" Severity="Warning" Title="Extension widgets couldn't load"/>
                <controls:WidgetContainer x:Name="PluginWidgets" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
