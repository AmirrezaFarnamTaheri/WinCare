<Page
    x:Class="WinCare.App.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinCare.App.Controls"
    xmlns:views="using:WinCare.App.Views"
    xmlns:converters="using:WinCare.App.Converters"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <converters:ThemeResourceBrushConverter x:Key="ThemeResourceBrushConverter" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" Padding="32,24,32,32" RowSpacing="28" MaxWidth="1600" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="WelcomeLayout" RowSpacing="16" ColumnSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="HomePageTitle" Style="{StaticResource PageTitleTextStyle}" Text="A clearer view of your PC." />
                    <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Understand what’s happening. Choose what comes next." />
                </StackPanel>
                <Button x:Name="StartCheckupButton" Grid.Column="1" Click="RunCheckupButton_Click" Style="{StaticResource PrimaryActionButtonStyle}" VerticalAlignment="Center" HorizontalAlignment="Left" AutomationProperties.AutomationId="HomeRunCheckup" AutomationProperties.Name="Open system checkup">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE768;" FontSize="16" /><TextBlock Text="Run checkup" /></StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Background="{ThemeResource HeroBackgroundBrush}" Padding="20">
                <Grid x:Name="HeroLayout" RowSpacing="24" ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Inside your PC" />
                        <Image x:Name="SystemAtlasImage" Grid.Row="1" Source="ms-appx:///Assets/SystemAtlas.png" Height="200" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Row="2" Style="{StaticResource RowSecondaryTextStyle}" Text="System illustration · not a scan of your hardware" HorizontalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="StatusCard" Grid.Column="1" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind ViewModel.EvidenceTitle, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.EvidenceSummary, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource TelemetryFontFamily}" FontSize="24" Foreground="{ThemeResource AccentTealBrush}" Text="{x:Bind ViewModel.EvidenceScoreText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="checks finished" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="CategoryLayout" Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource DiagnosticChannelStyle}" Click="NavCategory_System_Click" AutomationProperties.Name="Open system evidence">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE770;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="System" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.SystemStatus, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource DiagnosticChannelStyle}" Click="NavCategory_Security_Click" AutomationProperties.Name="Open security evidence">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEA18;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Security" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.SecurityStatus, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource DiagnosticChannelStyle}" Click="NavCategory_Performance_Click" AutomationProperties.Name="Open performance evidence">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9D9;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Performance" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.PerformanceStatus, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource DiagnosticChannelStyle}" Click="NavCategory_Storage_Click" AutomationProperties.Name="Open storage evidence">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F1;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Storage" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.StorageStatus, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource DiagnosticChannelStyle}" Click="NavCategory_Updates_Click" AutomationProperties.Name="Open updates evidence">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE950;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Updates" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.UpdatesStatus, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DiagnosticChannelStyle}" Click="NavCategory_Activity_Click" AutomationProperties.Name="Open activity evidence">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE81C;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Activity" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.ActivityStatus, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="2" Style="{StaticResource RowSecondaryTextStyle}" Text="Choose an area to see its latest result and available tools." />
                    </Grid>
                </Grid>
            </Border>
            <!-- Maintain: command state, risk and receipts remain owned by the view model. -->
            <StackPanel Grid.Row="2" Spacing="12">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Maintain your PC" />
                <Grid x:Name="CuratedActionsLayout" ColumnSpacing="16" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cleanup -->
                    <Border x:Name="QuickCleanCard" Style="{StaticResource SurfaceBorderStyle}" Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE74D;" FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Quick Clean" />
                                            <TextBlock FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="Temporary-file cleanup" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Template="{StaticResource StatusPillTemplate}" Background="{x:Bind ViewModel.CleanRiskBadgeBrushKey, Mode=OneTime, Converter={StaticResource ThemeResourceBrushConverter}}" BorderBrush="Transparent" Foreground="{ThemeResource PillTextBrush}" Content="{x:Bind ViewModel.CleanRiskBadge, Mode=OneTime}" />
                                </Grid>
                                <TextBlock Grid.Row="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.CleanDetailText, Mode=OneWay}" TextWrapping="Wrap" MinHeight="36" />
                                <Grid Grid.Row="2">
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Status" FontWeight="SemiBold" />
                                    <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTealBrush}" Text="{x:Bind ViewModel.CleanStatusText, Mode=OneWay}" />
                                </Grid>
                                <!-- Action and detailed evidence -->
                                <Grid Grid.Row="3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Command="{x:Bind ViewModel.QuickCleanCommand}"
                                        AutomationProperties.AutomationId="HomeQuickCleanButton"
                                        AutomationProperties.Name="Run Quick Clean">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsCleaning, Mode=OneWay}" Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(ViewModel.IsCleaning), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind ViewModel.CleanActionText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.ToggleInspectorCommand}"
                                        Padding="12,0"
                                        Height="44"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Background="{ThemeResource AccentTealSubtleBrush}"
                                        BorderBrush="{ThemeResource AccentTealBrush}"
                                        BorderThickness="1"
                                        AutomationProperties.AutomationId="QuickCleanInspectorButton"
                                        AutomationProperties.Name="Toggle cleanup telemetry inspector"
                                        ToolTipService.ToolTip="Show detailed measurements and targets">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentTealBrush}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                    <!-- Startup -->
                    <Border x:Name="StartupBoostCard" Grid.Column="1" Style="{StaticResource SurfaceBorderStyle}" Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Audit Startup" />
                                            <TextBlock FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="Startup inspection" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Template="{StaticResource StatusPillTemplate}" Background="{x:Bind ViewModel.StartupRiskBadgeBrushKey, Mode=OneTime, Converter={StaticResource ThemeResourceBrushConverter}}" BorderBrush="Transparent" Foreground="{ThemeResource PillTextBrush}" Content="{x:Bind ViewModel.StartupRiskBadge, Mode=OneTime}" />
                                </Grid>
                                <TextBlock Grid.Row="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.StartupDetailText, Mode=OneWay}" TextWrapping="Wrap" MinHeight="36" />
                                <Grid Grid.Row="2">
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Status" FontWeight="SemiBold" />
                                    <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTealBrush}" Text="{x:Bind ViewModel.StartupStatusText, Mode=OneWay}" />
                                </Grid>
                                <!-- Action and detailed evidence -->
                                <Grid Grid.Row="3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Command="{x:Bind ViewModel.StartupBoostCommand}"
                                        AutomationProperties.AutomationId="HomeStartupBoostButton"
                                        AutomationProperties.Name="Analyze Startup">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsAuditingStartup, Mode=OneWay}" Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(ViewModel.IsAuditingStartup), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind ViewModel.StartupActionText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.ToggleInspectorCommand}"
                                        Padding="12,0"
                                        Height="44"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Background="{ThemeResource AccentTealSubtleBrush}"
                                        BorderBrush="{ThemeResource AccentTealBrush}"
                                        BorderThickness="1"
                                        AutomationProperties.AutomationId="StartupBoostInspectorButton"
                                        AutomationProperties.Name="Toggle startup telemetry inspector"
                                        ToolTipService.ToolTip="Show detailed measurements and targets">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentTealBrush}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                    <!-- Network -->
                    <Border x:Name="NetworkRefreshCard" Grid.Column="2" Style="{StaticResource SurfaceBorderStyle}" Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE704;" FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Inspect Network" />
                                            <TextBlock FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="Network inspection" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Template="{StaticResource StatusPillTemplate}" Background="{x:Bind ViewModel.NetworkRiskBadgeBrushKey, Mode=OneTime, Converter={StaticResource ThemeResourceBrushConverter}}" BorderBrush="Transparent" Foreground="{ThemeResource PillTextBrush}" Content="{x:Bind ViewModel.NetworkRiskBadge, Mode=OneTime}" />
                                </Grid>
                                <TextBlock Grid.Row="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.NetworkDetailText, Mode=OneWay}" TextWrapping="Wrap" MinHeight="36" />
                                <Grid Grid.Row="2">
                                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Status" FontWeight="SemiBold" />
                                    <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTealBrush}" Text="{x:Bind ViewModel.NetworkStatusText, Mode=OneWay}" />
                                </Grid>
                                <!-- Action and detailed evidence -->
                                <Grid Grid.Row="3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Command="{x:Bind ViewModel.NetworkRefreshCommand}"
                                        AutomationProperties.AutomationId="HomeNetworkRefreshButton"
                                        AutomationProperties.Name="Check Network">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsRefreshingNetwork, Mode=OneWay}" Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(ViewModel.IsRefreshingNetwork), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind ViewModel.NetworkActionText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.ToggleInspectorCommand}"
                                        Padding="12,0"
                                        Height="44"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Background="{ThemeResource AccentTealSubtleBrush}"
                                        BorderBrush="{ThemeResource AccentTealBrush}"
                                        BorderThickness="1"
                                        AutomationProperties.AutomationId="NetworkRefreshInspectorButton"
                                        AutomationProperties.Name="Toggle network telemetry inspector"
                                        ToolTipService.ToolTip="Show detailed measurements and targets">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentTealBrush}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                    <!-- Progressive Disclosure: Telemetry Bay -->
                    <Border
                        x:Name="TelemetryBayCard"
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Margin="0,4,0,0"
                        CornerRadius="{StaticResource RadiusCardInner}"
                        Background="{ThemeResource TelemetryFrameBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Padding="16"
                        Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(ViewModel.IsInspectorExpanded), Mode=OneWay}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource AccentTealBrush}" />
                                    <TextBlock FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="NATIVE KERNEL TELEMETRY PROBE" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Padding="8,2" Background="{ThemeResource AccentTealSubtleBrush}" BorderBrush="{ThemeResource AccentTealBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusPill}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTealBrush}" Text="PROBE LATENCY:" />
                                        <TextBlock FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentTealBrush}" Text="{x:Bind ViewModel.TelemetryMetrics.LatencyFormatted, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="TARGET DISK ROOTS / PATHS" />
                                    <TextBlock FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind ViewModel.TelemetryMetrics.TargetPathsSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="KERNEL CPU" />
                                    <TextBlock FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind ViewModel.TelemetryMetrics.CpuFormatted, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="SYSTEM RAM" />
                                    <TextBlock FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind ViewModel.TelemetryMetrics.RamFormatted, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="2">
                                    <TextBlock FontFamily="{StaticResource BodyFontFamily}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="DISK FREE" />
                                    <TextBlock FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind ViewModel.TelemetryMetrics.DiskFormatted, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <Grid x:Name="SecondaryLayout" Grid.Row="3" ColumnSpacing="24" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Review your activity" />
                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind ViewModel.RecentActivityTitle, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind ViewModel.RecentActivitySummary, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border x:Name="SafetyCard" Grid.Column="1" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Review before applying" />
                        <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Checks collect evidence. Tool actions follow their displayed risk: routine changes can run directly; higher-impact changes require review and confirmation." />
                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Evidence coverage is not a complete health verdict. Activity records what actually happened." />
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel x:Name="ActionLayout" Grid.Row="4" Orientation="Horizontal" Spacing="12">
                <Button Content="View activity" Click="ViewActivityButton_Click" Style="{StaticResource QuietButtonStyle}" AutomationProperties.AutomationId="HomeViewActivity" AutomationProperties.Name="View activity" />
                <Button Content="Browse all tools" Click="BrowseToolsButton_Click" Style="{StaticResource QuietButtonStyle}" AutomationProperties.AutomationId="HomeBrowseTools" AutomationProperties.Name="Browse all tools" />
            </StackPanel>
            <InfoBar x:Name="PluginWidgetError" Grid.Row="5" IsOpen="False" IsClosable="True" Severity="Warning" Title="Plugin widgets unavailable" AutomationProperties.AutomationId="PluginWidgetError" AutomationProperties.Name="Plugin widget loading warning" />
            <controls:WidgetContainer x:Name="PluginWidgets" Grid.Row="6" Visibility="Collapsed" />
        </Grid>
    </ScrollViewer>
</Page>
