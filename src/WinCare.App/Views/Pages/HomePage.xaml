<Page
    x:Class="WinCare.App.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinCare.App.Controls"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" Padding="32,28,32,36" RowSpacing="28" MaxWidth="1440" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="WelcomeLayout" ColumnSpacing="24" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="6"><TextBlock x:Uid="HomePageTitle" Style="{StaticResource PageTitleTextStyle}" Text="Home"/><TextBlock MaxWidth="760" HorizontalAlignment="Left" Style="{StaticResource PageDescriptionTextStyle}" Text="See what needs attention, choose a useful next step, and get to any WinCare capability without digging through technical menus."/></StackPanel>
                <Button x:Name="StartCheckupButton" Grid.Column="1" Click="RunCheckupButton_Click" Style="{StaticResource PrimaryActionButtonStyle}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="Run checkup" AutomationProperties.AutomationId="HomeRunCheckup" AutomationProperties.Name="Run a read-only system checkup"/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Background="{ThemeResource HeroBackgroundBrush}">
                <Grid x:Name="HeroLayout" ColumnSpacing="28" RowSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="12" MaxWidth="760"><TextBlock Style="{StaticResource RowSecondaryTextStyle}" FontWeight="SemiBold" Text="YOUR NEXT STEP"/><TextBlock Style="{StaticResource SectionHeaderTextStyle}" FontSize="28" Text="{x:Bind ViewModel.EvidenceTitle, Mode=OneWay}"/><TextBlock Style="{StaticResource PageDescriptionTextStyle}" FontSize="15" Text="{x:Bind ViewModel.EvidenceSummary, Mode=OneWay}"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Click="RunCheckupButton_Click" Style="{StaticResource PrimaryActionButtonStyle}" Content="Run checkup" AutomationProperties.Name="Run checkup"/><Button Click="ViewActivityButton_Click" Style="{StaticResource QuietButtonStyle}" Content="View activity" AutomationProperties.Name="View activity"/></StackPanel></StackPanel>
                    <Border x:Name="EvidenceSummaryCard" Grid.Column="1" Padding="18" Background="{ThemeResource SurfaceSecondaryBrush}" CornerRadius="{StaticResource RadiusControl}"><StackPanel Spacing="8"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Evidence collected"/><TextBlock Style="{StaticResource PageTitleTextStyle}" FontSize="30" Text="{x:Bind ViewModel.EvidenceScoreText, Mode=OneWay}"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="A checkup is read-only. Any later change opens separately for review."/></StackPanel></Border>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Spacing="12"><StackPanel Spacing="4"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Recommended"/><TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Common tasks stay one click away. Open a task to review its current targets and options."/></StackPanel>
                <Grid x:Name="RecommendationsGrid" ColumnSpacing="14" RowSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button x:Name="CleanupRecommendation" Style="{StaticResource RecommendationButtonStyle}" Click="OpenCleanup_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Review cleanup options"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE74D;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Clean up storage"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Find temporary files and storage pressure."/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"/></Grid></Button>
                    <Button x:Name="StartupRecommendation" Grid.Column="1" Style="{StaticResource RecommendationButtonStyle}" Click="OpenStartup_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Review apps and startup"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE768;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Apps &amp; startup"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Review startup entries and installed apps."/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"/></Grid></Button>
                    <Button x:Name="NetworkRecommendation" Grid.Column="2" Style="{StaticResource RecommendationButtonStyle}" Click="OpenNetwork_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Review network and updates"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE701;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Network &amp; updates"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Inspect connectivity, DNS, and Windows Update."/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"/></Grid></Button>
                </Grid>
            </StackPanel>
            <Grid x:Name="OverviewGrid" Grid.Row="3" ColumnSpacing="18" RowSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource DashboardCardStyle}"><StackPanel Spacing="14"><StackPanel Spacing="3"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="System at a glance"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Latest evidence from the areas people use most."/></StackPanel>
                    <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_System_Click" HorizontalContentAlignment="Stretch"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="System"/><TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.SystemStatus, Mode=OneWay}"/></Grid></Button>
                    <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Security_Click" HorizontalContentAlignment="Stretch"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Security"/><TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.SecurityStatus, Mode=OneWay}"/></Grid></Button>
                    <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Performance_Click" HorizontalContentAlignment="Stretch"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Performance"/><TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.PerformanceStatus, Mode=OneWay}"/></Grid></Button>
                    <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Storage_Click" HorizontalContentAlignment="Stretch"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Storage"/><TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.StorageStatus, Mode=OneWay}"/></Grid></Button>
                    <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Updates_Click" HorizontalContentAlignment="Stretch"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Updates"/><TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.UpdatesStatus, Mode=OneWay}"/></Grid></Button>
                </StackPanel></Border>
                <Border x:Name="RecentActivityCard" Grid.Column="1" Style="{StaticResource DashboardCardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Recent activity"/><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind ViewModel.RecentActivityTitle, Mode=OneWay}"/><TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind ViewModel.RecentActivitySummary, Mode=OneWay}"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.ActivityStatus, Mode=OneWay}"/><Button Click="ViewActivityButton_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Content="Open activity"/></StackPanel></Border>
            </Grid>
            <StackPanel Grid.Row="4" Spacing="10"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Explore WinCare"/><StackPanel x:Name="ExploreActions" Orientation="Horizontal" Spacing="10"><Button Click="BrowseToolsButton_Click" Style="{StaticResource QuietButtonStyle}" Content="Power tools"/><Button Click="OpenExtensions_Click" Style="{StaticResource QuietButtonStyle}" Content="Extensions"/><Button Click="OpenTroubleshoot_Click" Style="{StaticResource QuietButtonStyle}" Content="Troubleshoot"/></StackPanel></StackPanel>
            <StackPanel Grid.Row="5" Spacing="12"><InfoBar x:Name="PluginWidgetError" IsOpen="False" IsClosable="True" Severity="Warning" Title="Extension widgets unavailable"/><controls:WidgetContainer x:Name="PluginWidgets" Visibility="Collapsed"/></StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
