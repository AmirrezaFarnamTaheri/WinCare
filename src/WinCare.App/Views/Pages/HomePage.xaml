<Page
    x:Class="WinCare.App.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinCare.App.Controls"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" Padding="32,28,32,36" RowSpacing="28" MaxWidth="1440" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Uid="HomePageTitle" Style="{StaticResource PageTitleTextStyle}" Text="Home"/>
                <TextBlock MaxWidth="760" HorizontalAlignment="Left" Style="{StaticResource PageDescriptionTextStyle}" Text="See what needs attention and get where you need to go."/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Background="{ThemeResource HeroBackgroundBrush}">
                <Grid x:Name="HeroLayout" ColumnSpacing="28" RowSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="12" MaxWidth="760"><TextBlock Style="{StaticResource RowSecondaryTextStyle}" FontWeight="SemiBold" Text="Right now"/><TextBlock Style="{StaticResource MetricTextStyle}" Text="{x:Bind ViewModel.CheckupTitle, Mode=OneWay}"/><TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind ViewModel.CheckupSummary, Mode=OneWay}"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Click="RunCheckupButton_Click" Style="{StaticResource PrimaryActionButtonStyle}" Content="Run checkup" AccessKey="R" AutomationProperties.AutomationId="HomeRunCheckup" AutomationProperties.Name="Run checkup"/><Button Click="ViewActivityButton_Click" Style="{StaticResource QuietButtonStyle}" Content="View activity" AutomationProperties.Name="View activity"/></StackPanel></StackPanel>
                    <Border x:Name="CheckupSummaryCard" Grid.Column="1" Padding="18" Background="{ThemeResource SurfaceSecondaryBrush}" CornerRadius="{StaticResource RadiusControl}"><StackPanel Spacing="8"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Checkup coverage"/><TextBlock Style="{StaticResource MetricTextStyle}" Text="{x:Bind ViewModel.CheckupCoverageText, Mode=OneWay}"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Open an area for details."/></StackPanel></Border>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Spacing="12"><StackPanel Spacing="4"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Common care"/><TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Already know what you want to do? Start here."/></StackPanel>
                <Grid x:Name="RecommendationsGrid" ColumnSpacing="14" RowSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button x:Name="CleanupRecommendation" Style="{StaticResource RecommendationButtonStyle}" Click="OpenCleanup_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open storage cleanup"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE74D;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}" AutomationProperties.AccessibilityView="Raw"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Clean up storage"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Free up space and see what's taking room."/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/></Grid></Button>
                    <Button x:Name="StartupRecommendation" Grid.Column="1" Style="{StaticResource RecommendationButtonStyle}" Click="OpenStartup_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open apps and startup"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE768;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}" AutomationProperties.AccessibilityView="Raw"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Apps &amp; startup"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Manage installed apps and what starts with Windows."/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/></Grid></Button>
                    <Button x:Name="NetworkRecommendation" Grid.Column="2" Style="{StaticResource RecommendationButtonStyle}" Click="OpenNetwork_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open network and updates"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE701;" FontSize="22" Foreground="{ThemeResource AccentTealBrush}" AutomationProperties.AccessibilityView="Raw"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Network &amp; updates"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Check connectivity, DNS, and Windows Update."/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/></Grid></Button>
                </Grid>
            </StackPanel>
            <Grid x:Name="OverviewGrid" Grid.Row="3" ColumnSpacing="18" RowSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource DashboardCardStyle}"><StackPanel Spacing="14"><StackPanel Spacing="4"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="System at a glance"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="The latest result from each Checkup area."/></StackPanel>
                    <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_System_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open system checkup details"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Windows &amp; hardware"/><TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.SystemStatus, Mode=OneWay}"/></Grid></Button>
                    <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Storage_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open storage cleanup"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Storage"/><TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.StorageStatus, Mode=OneWay}"/></Grid></Button>
                    <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Security_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open security care"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Security"/><TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.SecurityStatus, Mode=OneWay}"/></Grid></Button>
                    <Button Style="{StaticResource StatusRowButtonStyle}" Click="NavCategory_Updates_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open network and update care"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Windows Update"/><TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.UpdatesStatus, Mode=OneWay}"/></Grid></Button>
                </StackPanel></Border>
                <Border x:Name="RecentActivityCard" Grid.Column="1" Style="{StaticResource DashboardCardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Recent activity"/><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind ViewModel.RecentActivityTitle, Mode=OneWay}"/><TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="{x:Bind ViewModel.RecentActivitySummary, Mode=OneWay}"/><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.ActivityStatus, Mode=OneWay}"/><Button Click="ViewActivityButton_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Content="Open activity" AutomationProperties.Name="Open activity history"/></StackPanel></Border>
            </Grid>
            <StackPanel Grid.Row="4" Spacing="10"><TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="More tools"/><StackPanel x:Name="ExploreActions" Orientation="Horizontal" Spacing="10"><Button Click="BrowseToolsButton_Click" Style="{StaticResource QuietButtonStyle}" Content="Power tools" AutomationProperties.Name="Open Power tools"/><Button Click="OpenExtensions_Click" Style="{StaticResource QuietButtonStyle}" Content="Extensions" AutomationProperties.Name="Open Extensions"/><Button Click="OpenTroubleshoot_Click" Style="{StaticResource QuietButtonStyle}" Content="Troubleshoot" AutomationProperties.Name="Open Troubleshoot"/></StackPanel></StackPanel>
            <StackPanel Grid.Row="5" Spacing="12"><InfoBar x:Name="PluginWidgetError" IsOpen="False" IsClosable="True" Severity="Warning" Title="Extension widgets couldn't load"/><controls:WidgetContainer x:Name="PluginWidgets" Visibility="Collapsed"/></StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
