<Page
    x:Class="WinCare.App.Views.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinCare.App.Views"
    xmlns:vm="using:WinCare.App.ViewModels.Pages"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <Grid Padding="32,24,32,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Activity" />
            <TextBlock MaxWidth="760" HorizontalAlignment="Left" Style="{StaticResource PageDescriptionTextStyle}" Text="Track running work, decisions that need attention, completed changes, and reports." />
        </StackPanel>

        <InfoBar
            x:Name="AttentionInfoBar"
            Grid.Row="1"
            Margin="0"
            IsOpen="{x:Bind ViewModel.HasAttentionItems, Mode=OneWay}"
            IsClosable="False"
            Severity="Warning"
            Title="Attention required"
            Message="One or more operations require user review or elevated confirmation."
            AutomationProperties.AutomationId="AttentionInfoBar"
            AutomationProperties.Name="Attention required" />

        <SelectorBar
            x:Name="SectionSelector"
            Grid.Row="2"
            SelectionChanged="SectionSelector_SelectionChanged"
            AutomationProperties.AutomationId="ActivityPageTabs"
            AutomationProperties.Name="Activity sections">
            <SelectorBarItem Text="Running" AutomationProperties.Name="Running" />
            <SelectorBarItem Text="Needs attention" AutomationProperties.Name="Needs attention" />
            <SelectorBarItem Text="Completed" AutomationProperties.Name="Completed" />
            <SelectorBarItem Text="Reports" AutomationProperties.Name="Reports" />
        </SelectorBar>

        <Grid Grid.Row="3">
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="TableHeader"
                        Height="42"
                        Padding="16,0"
                        ColumnSpacing="16"
                        Background="{ThemeResource SurfaceSecondaryBrush}"
                        Visibility="{x:Bind views:LayoutVisibility.InvertBoolToVisibility(ViewModel.IsCompactLayout), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="Item" />
                        <TextBlock x:Name="DescriptionHeader" Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}" Text="What it does" />
                        <TextBlock x:Name="StateHeader" Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}" Text="State" />
                        <TextBlock x:Name="NotesHeader" Grid.Column="3" Style="{StaticResource ColumnHeaderTextStyle}" Text="Notes" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.CurrentRows, Mode=OneWay}"
                        SelectionMode="None"
                        AutomationProperties.AutomationId="ActivityPageRows"
                        AutomationProperties.Name="Activity information">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="68" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageRow">
                                <Grid Padding="16,10">
                                    <Grid
                                        ColumnSpacing="16"
                                        Visibility="{x:Bind views:LayoutVisibility.InvertBoolToVisibility(IsCompact), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Description}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind State}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                    </Grid>
                                    <StackPanel
                                        Spacing="5"
                                        Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(IsCompact), Mode=OneWay}">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Description}" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RowSecondaryTextStyle}" Text="State" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind State}" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RowSecondaryTextStyle}" Text="Notes" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <InfoBar
                Margin="12"
                VerticalAlignment="Top"
                IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                IsClosable="False"
                Severity="Informational"
                Title="Nothing to show"
                Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
