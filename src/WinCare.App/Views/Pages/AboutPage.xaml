<Page
    x:Class="WinCare.App.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,28,28,32" MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
            <Image Width="84" Height="84" HorizontalAlignment="Left" Source="/Assets/Square150x150Logo.png" AutomationProperties.Name="WinCare logo" />
            <TextBlock x:Uid="AboutPageTitle" Style="{StaticResource PageTitleTextStyle}" Text="WinCare" />
            <TextBlock Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap" Text="WinCare helps you understand, maintain, and repair a Windows PC without hiding what it's doing." />
            <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,24,0,8">
                <StackPanel Spacing="6"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Version" /><TextBlock Style="{StaticResource RowSecondaryTextStyle}" FontFamily="{StaticResource TelemetryFontFamily}" Text="{x:Bind VersionText}" /></StackPanel>
            </Border>
            <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,24,0,8">
                <StackPanel Spacing="6"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Open source" /><TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="WinCare is open-source software under the Apache License 2.0. The source code, issue tracker, and security policy are on GitHub." /></StackPanel>
            </Border>
            <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,24,0,8">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4"><TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Support WinCare" /></StackPanel>
                    <Grid ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><HyperlinkButton NavigateUri="https://github.com/AmirrezaFarnamTaheri/WinCare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" MinHeight="44" Background="{ThemeResource SurfaceSecondaryBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"><StackPanel Spacing="4"><TextBlock Text="Star on GitHub" Style="{StaticResource RowTitleTextStyle}" /><TextBlock Text="Help more people find WinCare" Style="{StaticResource RowSecondaryTextStyle}" /></StackPanel></HyperlinkButton><HyperlinkButton Grid.Column="1" NavigateUri="https://github.com/AmirrezaFarnamTaheri/WinCare/issues" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" MinHeight="44" Background="{ThemeResource SurfaceSecondaryBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"><StackPanel Spacing="4"><TextBlock Text="Report an issue" Style="{StaticResource RowTitleTextStyle}" /><TextBlock Text="Bugs, ideas, and feedback" Style="{StaticResource RowSecondaryTextStyle}" /></StackPanel></HyperlinkButton></Grid>
                    <StackPanel Spacing="6" Margin="0,4,0,0"><TextBlock Text="Contact maintainer" FontWeight="SemiBold" /><TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Amirreza “Farnam” Taheri" /><HyperlinkButton Content="taherifarnam@gmail.com" NavigateUri="mailto:taherifarnam@gmail.com" Padding="0" Margin="0" MinHeight="44" MinWidth="44" HorizontalAlignment="Left" /></StackPanel>
                    <StackPanel Spacing="8" Margin="0,6,0,0"><TextBlock Text="Donate" FontWeight="SemiBold" />
                        <Border Background="{ThemeResource SurfaceSecondaryBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="16,10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Bitcoin" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Style="{StaticResource TelemetryTextStyle}" Text="bc1q68g4m4denjw4smhvwmnz5fychuj3ge2vupx07w" VerticalAlignment="Center" IsTextSelectionEnabled="True" /><Button Grid.Column="2" Content="Copy" Style="{StaticResource QuietButtonStyle}" Click="CopyBtc_Click" AutomationProperties.Name="Copy Bitcoin address" /></Grid></Border>
                        <Border Background="{ThemeResource SurfaceSecondaryBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="16,10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Ethereum" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Style="{StaticResource TelemetryTextStyle}" Text="0xbd5af5d1517317111db9523d6bb42fceae887abb" VerticalAlignment="Center" IsTextSelectionEnabled="True" /><Button Grid.Column="2" Content="Copy" Style="{StaticResource QuietButtonStyle}" Click="CopyEth_Click" AutomationProperties.Name="Copy Ethereum address" /></Grid></Border>
                        <Border Background="{ThemeResource SurfaceSecondaryBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="16,10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="TRON" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Style="{StaticResource TelemetryTextStyle}" Text="TRjFLA1Dd32Bw1i3FxjZW5dmVub5UfXFSS" VerticalAlignment="Center" IsTextSelectionEnabled="True" /><Button Grid.Column="2" Content="Copy" Style="{StaticResource QuietButtonStyle}" Click="CopyTron_Click" AutomationProperties.Name="Copy TRON address" /></Grid></Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
