<Page
    x:Class="WinCare.App.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,28,28,32" MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
            <Image Width="84" Height="84" HorizontalAlignment="Left" Source="/Assets/Square150x150Logo.png" AutomationProperties.Name="WinCare logo" />
            <TextBlock x:Uid="AboutPageTitle" Style="{StaticResource PageTitleTextStyle}" Text="WinCare" />
            <TextBlock Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap" Text="A clearer view of your PC. A considered next step. WinCare brings Windows care, repair, security, and recovery into one workspace. Every change needs a preview and your approval." />
            <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,24,0,8">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Version" />
                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" FontFamily="{StaticResource TelemetryFontFamily}" Text="{x:Bind VersionText}" />
                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="Build information comes from the running application assembly rather than a hard-coded release label." />
                </StackPanel>
            </Border>
            <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,24,0,8">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Safety model" />
                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="Read-only evidence is separated from mutation. Remote plugin installation remains disabled unless catalog trust is anchored to a WinCare-pinned signing key. Activity records preserve outcomes and explicitly flag uncertain final state after a mutation fault." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
