<Page
    x:Class="WinCare.App.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,24,32,32">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
            <Image Width="84" Height="84" HorizontalAlignment="Left" Source="/Assets/Square150x150Logo.png" />
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="WinCare" />
            <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Native Windows care, repair, security, and recovery tools. Every retained command is cataloged, and each mutating operation must pass review, policy, evidence, journaling, and recovery gates." />
            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Native migration foundation 0.1" />
        </StackPanel>
    </Grid>
</Page>
