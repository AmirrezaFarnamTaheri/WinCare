<Page
    x:Class="WinCare.App.Views.Pages.CheckupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinCare.App.Views"
    xmlns:vm="using:WinCare.App.ViewModels.Pages"
    xmlns:converters="using:WinCare.App.Converters"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <converters:ThemeResourceBrushConverter x:Key="ThemeResourceBrushConverter" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,28,28,32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock x:Uid="CheckupPageTitle" Style="{StaticResource PageTitleTextStyle}" Text="Checkup" />
                <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="Inspect system health and review recommended maintenance." TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Background="{ThemeResource HeroBackgroundBrush}">
                <Grid>
                    <Grid
                        ColumnSpacing="24"
                        Visibility="{x:Bind views:LayoutVisibility.InvertBoolToVisibility(ViewModel.IsCompactLayout), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border MinHeight="132" Padding="16" CornerRadius="{StaticResource RadiusControl}" BorderThickness="1" BorderBrush="{x:Bind ViewModel.HealthScoreBrushKey, Mode=OneWay, Converter={StaticResource ThemeResourceBrushConverter}}" Background="{ThemeResource AccentTealSubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontFamily="{StaticResource DisplayFontFamily}" FontSize="32" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.HealthScoreBrushKey, Mode=OneWay, Converter={StaticResource ThemeResourceBrushConverter}}" HorizontalAlignment="Center" Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" HorizontalAlignment="Center" Text="{x:Bind ViewModel.HealthScoreDetail, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Checkup findings" />
                            <TextBlock Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.RunSummary, Mode=OneWay}" />
                            <Button HorizontalAlignment="Left" Style="{StaticResource PrimaryActionButtonStyle}" Command="{x:Bind ViewModel.RunQuickCheckCommand}" AutomationProperties.AutomationId="RunQuickCheck" AutomationProperties.Name="Run a read-only quick check">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(ViewModel.IsRunning), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.RunActionText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Column="2" Width="1" Background="{ThemeResource CardBorderBrush}" Margin="0,8" />
                        <StackPanel Grid.Column="3" Spacing="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="44" Height="44" CornerRadius="{StaticResource RadiusControl}" Background="{ThemeResource AccentTealSubtleBrush}" BorderThickness="1" BorderBrush="{ThemeResource AccentTealBrush}">
                                    <FontIcon Glyph="&#xE8C8;" Foreground="{ThemeResource AccentTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" Text="Review before applying" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap" Text="Checks observe your device. Any recommended repair stays a proposal until you review and approve it." />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Spacing="18"
                        Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(ViewModel.IsCompactLayout), Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border MinHeight="100" Padding="12" CornerRadius="{StaticResource RadiusControl}" BorderThickness="1" BorderBrush="{x:Bind ViewModel.HealthScoreBrushKey, Mode=OneWay, Converter={StaticResource ThemeResourceBrushConverter}}" Background="{ThemeResource AccentTealSubtleBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontFamily="{StaticResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.HealthScoreBrushKey, Mode=OneWay, Converter={StaticResource ThemeResourceBrushConverter}}" HorizontalAlignment="Center" Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" Text="{x:Bind ViewModel.HealthScoreDetail, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="Checkup findings" />
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.RunSummary, Mode=OneWay}" />
                                <Button HorizontalAlignment="Left" Style="{StaticResource PrimaryActionButtonStyle}" Command="{x:Bind ViewModel.RunQuickCheckCommand}" AutomationProperties.AutomationId="RunQuickCheckCompact" AutomationProperties.Name="Run a read-only quick check">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(ViewModel.IsRunning), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.RunActionText, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardBorderBrush}" />
                        <StackPanel Spacing="7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="{ThemeResource AccentTealBrush}" />
                                <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="Review before applying" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="Checks observe your device. Recommended repairs remain proposals until you review and approve them." />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Padding="16,0"
                    Visibility="{x:Bind views:LayoutVisibility.InvertBoolToVisibility(ViewModel.IsCompactLayout), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="Category" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}" Text="Status" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}" Text="Evidence" />
                    <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderTextStyle}" Text="Action" Margin="8,0,0,0" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CurrentRows, Mode=OneWay}" SelectionMode="None" AutomationProperties.AutomationId="CheckupPageRows" AutomationProperties.Name="Checkup information">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="MinHeight" Value="68" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageRow">
                            <Border Style="{StaticResource SurfaceBorderStyle}" Padding="20,16">
                                <Grid>
                                    <Grid
                                        ColumnSpacing="16"
                                        Visibility="{x:Bind views:LayoutVisibility.InvertBoolToVisibility(IsCompact), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="{x:Bind Description}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{x:Bind StatusBrushKey, Mode=OneWay, Converter={StaticResource ThemeResourceBrushConverter}}" />
                                            <TextBlock FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind StatusBrushKey, Mode=OneWay, Converter={StaticResource ThemeResourceBrushConverter}}" Text="{x:Bind State, Mode=OneWay}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" FontFamily="{StaticResource TelemetryFontFamily}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{x:Bind Detail, Mode=OneWay}" VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="3"
                                            Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(HasAction), Mode=OneWay}"
                                            Command="{x:Bind ActionCommand, Mode=OneWay}"
                                            Content="{x:Bind ActionText, Mode=OneWay}"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Padding="12,4"
                                            MinHeight="44"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="Resolve finding" />
                                    </Grid>

                                    <StackPanel
                                        Spacing="7"
                                        Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(IsCompact), Mode=OneWay}">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Description}" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" FontWeight="SemiBold" Text="Status" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" FontFamily="{StaticResource TelemetryFontFamily}" FontWeight="SemiBold" Foreground="{x:Bind StatusBrushKey, Mode=OneWay, Converter={StaticResource ThemeResourceBrushConverter}}" Text="{x:Bind State, Mode=OneWay}" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" FontWeight="SemiBold" Text="Evidence" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" FontFamily="{StaticResource TelemetryFontFamily}" Text="{x:Bind Detail, Mode=OneWay}" TextWrapping="Wrap" />
                                        </Grid>
                                        <Button
                                            Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(HasAction), Mode=OneWay}"
                                            Command="{x:Bind ActionCommand, Mode=OneWay}"
                                            Content="{x:Bind ActionText, Mode=OneWay}"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Padding="10,4"
                                            MinHeight="44"
                                            FontSize="13"
                                            HorizontalAlignment="Left"
                                            Margin="0,4,0,0"
                                            AutomationProperties.Name="Resolve finding" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <SelectorBar x:Name="SectionSelector" Grid.Row="3" SelectionChanged="SectionSelector_SelectionChanged" AutomationProperties.AutomationId="CheckupPageTabs" AutomationProperties.Name="Checkup sections">
                <SelectorBarItem Text="Quick check" AutomationProperties.Name="Quick check" />
                <SelectorBarItem Text="Results" AutomationProperties.Name="Results" />
            </SelectorBar>
        </Grid>
    </ScrollViewer>
</Page>
