<Page
    x:Class="WinCare.App.Views.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinCare.App.Controls"
    NavigationCacheMode="Enabled"
    SizeChanged="Page_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="HelpLayout" Padding="32,28,32,28" MaxWidth="980"
                    HorizontalAlignment="Stretch" Spacing="18">
            <controls:PageHeaderControl
                Title="Help"
                Description="New to WinCare? Start with Checkup, then follow the result to the right care page." />


            <InfoBar x:Name="TourError" IsOpen="False" Severity="Error" IsClosable="True"
                     Title="Tour couldn't open" Message="Close any open dialog, then try taking the tour again." />
            <Border Padding="20" Style="{StaticResource SurfaceBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Start here" />
                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="Checkup looks at a few important Windows areas without changing anything." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Open Checkup" Style="{StaticResource PrimaryActionButtonStyle}" Click="OpenCheckup_Click" AutomationProperties.AutomationId="HelpOpenCheckup" AutomationProperties.Name="Open Checkup" />
                        <Button Content="Take the tour" Style="{StaticResource QuietButtonStyle}" Click="ShowTour_Click" AutomationProperties.AutomationId="HelpShowTour" AutomationProperties.Name="Take the WinCare tour" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="10">
                <TextBlock Text="Everyday tools" Style="{StaticResource SectionHeaderTextStyle}" />
                <Grid x:Name="EverydayActions" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Button x:Name="BrowseStorageButton" Content="Files &amp; storage" Click="OpenFiles_Click"
                            Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Browse local files and storage" />
                    <Button x:Name="ViewProcessesButton" Grid.Column="1" Content="Processes" Click="OpenProcesses_Click"
                            Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Monitor running processes and memory" />
                    <Button x:Name="ManageDownloadsButton" Grid.Column="2" Content="Downloads" Click="OpenDownloads_Click"
                            Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Manage file downloads" />
                </Grid>
                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="Browse files, inspect running apps, and manage transfers without searching through the full tool catalog."
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Before WinCare changes anything" />
                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="Read-only checks run without approval. Changes with more impact ask you to review or confirm them first. Checkup never changes the PC." />
                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="Activity shows what's running, what finished, and anything that needs another look." />
                <Button Content="Open Activity" Style="{StaticResource QuietButtonStyle}" Click="OpenActivity_Click" HorizontalAlignment="Left" AutomationProperties.AutomationId="HelpOpenActivity" AutomationProperties.Name="Open Activity" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Keyboard" />
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                    <TextBlock Style="{StaticResource TelemetryTextStyle}" Text="Ctrl+K" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="Search WinCare" />
                    <TextBlock Grid.Row="1" Style="{StaticResource TelemetryTextStyle}" Text="Ctrl+F" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="Focus the search box in Power tools" />
                    <TextBlock Grid.Row="2" Style="{StaticResource TelemetryTextStyle}" Text="Esc" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="Close an open tool inspector" />
                    <TextBlock Grid.Row="3" Style="{StaticResource TelemetryTextStyle}" Text="Tab / arrow keys" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="Move through navigation, tabs, lists, dialogs, and controls" />
                </Grid>
            </StackPanel>

            <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Settings" Style="{StaticResource QuietButtonStyle}" Click="OpenSettings_Click" AutomationProperties.Name="Open Settings" /><Button Content="About WinCare" Style="{StaticResource QuietButtonStyle}" Click="OpenAbout_Click" AutomationProperties.Name="Open About WinCare" /></StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
