<Page
    x:Class="WinCare.App.Views.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,24,32,32">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Help and documentation" />
            <TextBlock Style="{StaticResource PageDescriptionTextStyle}" Text="WinCare explains each task in plain language, shows what it may change, and keeps technical evidence under Advanced details." />
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Keyboard" Message="Press Ctrl+K to search all tasks and tools. Use Tab and arrow keys to move through navigation, tabs, tables, and details." />
        </StackPanel>
    </Grid>
</Page>
