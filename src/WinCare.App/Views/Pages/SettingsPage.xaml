<Page
    x:Class="WinCare.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,32" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Settings" />
                <TextBlock MaxWidth="760" HorizontalAlignment="Left" Style="{StaticResource PageDescriptionTextStyle}" Text="Preferences saved for this Windows account." />
            </StackPanel>
            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="App theme" />
                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="Use the Windows theme or choose a persistent light or dark appearance." />
                    </StackPanel>
                    <ComboBox x:Name="ThemeSelector" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Themes}" SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" SelectionChanged="ThemeSelector_SelectionChanged" AutomationProperties.AutomationId="ThemeSelector" AutomationProperties.Name="App theme" />
                </Grid>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Local data" />
                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="Open WinCare's settings, reports, and operation records for this account." />
                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind ViewModel.DataDirectory}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open folder" Click="OpenDataFolderButton_Click" AutomationProperties.AutomationId="OpenDataFolder" AutomationProperties.Name="Open WinCare data folder" />
                </Grid>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}" Background="{ThemeResource HeroBackgroundBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="Safety policy" />
                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" Text="Read-only checks run directly. Changes remain locked behind preview, explicit approval, receipts, and available recovery actions. These protections are product guarantees rather than decorative switches." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
