<Page
    x:Class="WinCare.App.Views.Pages.AiDoctorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinCare.App.Views.Pages"
    xmlns:vm="using:WinCare.App.ViewModels.Pages"
    xmlns:diag="using:WinCare.Application.Diagnostics"
    NavigationCacheMode="Required">

    <Grid RowDefinitions="Auto,*,Auto" Padding="28,28,28,32">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
            <TextBlock Text="Troubleshoot" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock MaxWidth="760" HorizontalAlignment="Left" Text="Tell WinCare what's going wrong. It checks local Windows signals and suggests a few things you can review." Style="{StaticResource PageDescriptionTextStyle}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="ChatScrollViewer" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DoctorChatMessage"><Grid Margin="0,0,0,16"><Border CornerRadius="{StaticResource RadiusControl}" Padding="20,16" MaxWidth="800" HorizontalAlignment="{x:Bind local:AiDoctorPage.UserToHorizontalAlignment(IsUser), Mode=OneTime}" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1"><StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind Sender}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentTealBrush}" /><TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}" FontSize="14" />
                    <ItemsControl ItemsSource="{x:Bind ActionPlan.ProposedSteps, Mode=OneTime}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate x:DataType="diag:ProposedActionStep"><Border Margin="0,6,0,6" Padding="0,16,0,8" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0"><Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Grid.Column="0" Spacing="2"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}"/><TextBlock Text="{x:Bind Description}" Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="{x:Bind ActionButtonText}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="ExecuteStepButton_Click" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind ActionAccessibleName}"/></Grid>
                        <TextBlock Grid.Row="1" Text="{x:Bind ReviewContextText}" Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="This opens in Power tools so you can see the details before anything runs." Style="{StaticResource RowSecondaryTextStyle}"/>
                    </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></Border></Grid></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox Grid.Column="0" PlaceholderText="What's going wrong?" Text="{x:Bind ViewModel.UserPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="PromptTextBox_KeyDown" IsEnabled="{x:Bind ViewModel.IsAnalyzing, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay, FallbackValue=True}" AutomationProperties.AutomationId="DoctorPrompt" AutomationProperties.Name="Describe the Windows problem"/>
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="SendButton_Click" IsEnabled="{x:Bind ViewModel.IsAnalyzing, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay, FallbackValue=True}" AutomationProperties.AutomationId="DiagnoseProblem" AutomationProperties.Name="Check the described problem"><StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay}" Visibility="{x:Bind local:AiDoctorPage.BoolToVisibility(ViewModel.IsAnalyzing), Mode=OneWay}" /><TextBlock Text="Check" /></StackPanel></Button>
        </Grid>
    </Grid>
</Page>
