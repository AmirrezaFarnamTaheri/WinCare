<Page
    x:Class="WinCare.App.Views.Pages.AiDoctorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinCare.App.ViewModels.Pages"
    xmlns:diag="using:WinCare.Application.Diagnostics">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,24,24,24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="AI System Doctor" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource AccentTealBrush}" FontWeight="SemiBold" />
            <TextBlock Text="On-device intelligent diagnosis and automated remediation action plans (Heuristic &amp; DirectML Ready)." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Chat Conversation Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="ChatScrollViewer" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DoctorChatMessage">
                        <Grid Margin="0,0,0,16">
                            <Border CornerRadius="8" Padding="14,10" MaxWidth="720"
                                    HorizontalAlignment="{x:Bind IsUser, Converter={StaticResource BooleanToHorizontalAlignmentConverter}, FallbackValue=Left}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Sender}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentTealBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                                    
                                    <!-- Proposed Action Steps -->
                                    <ItemsControl ItemsSource="{x:Bind ActionPlan.ProposedSteps, Mode=OneWay}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="diag:ProposedActionStep">
                                                <Border Margin="0,6,0,6" Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14"/>
                                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="{x:Bind ActionButtonText}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="ExecuteStepButton_Click" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Title}"/>
                                                        </Grid>
                                                        
                                                        <!-- Metadata Badges & Target Context -->
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="6,2" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <TextBlock Text="{x:Bind RiskBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTealBrush}"/>
                                                            </Border>
                                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="6,2" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <TextBlock Text="{x:Bind ElevationBadgeText}" FontSize="11" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            </Border>
                                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="6,2" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <TextBlock Text="{x:Bind AffectedResource}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        
                                                        <TextBlock Grid.Row="2" Text="{x:Bind CommandId}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Consolas"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Prompt Input Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox Grid.Column="0"
                     PlaceholderText="Describe your PC issue (e.g., 'Clean up temp files on C drive', 'Why is RAM high?')..."
                     Text="{x:Bind ViewModel.UserPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="PromptTextBox_KeyDown"
                     IsEnabled="{x:Bind ViewModel.IsAnalyzing, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay, FallbackValue=True}"
                     AutomationProperties.Name="AI Doctor Prompt Input"/>

            <Button Grid.Column="1"
                    Content="Ask Doctor"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SendButton_Click"
                    IsEnabled="{x:Bind ViewModel.IsAnalyzing, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay, FallbackValue=True}"
                    AutomationProperties.Name="Submit Diagnosis Prompt"/>
        </Grid>
    </Grid>
</Page>
