<Page
    x:Class="WinCare.App.Views.Pages.PluginStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinCare.App.Views.Pages"
    xmlns:vm="using:WinCare.App.ViewModels.Pages">

    <Grid Padding="32,24,32,32" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Plugin store" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock MaxWidth="760" HorizontalAlignment="Left" Text="Discover extensions, inspect their capabilities, and choose what to trust and install." Style="{StaticResource PageDescriptionTextStyle}" />
            </StackPanel>

            <AutoSuggestBox x:Name="PluginSearchBox" Grid.Column="1" Width="280" VerticalAlignment="Center" PlaceholderText="Search plugins or authors" QueryIcon="Find" TextChanged="SearchBox_TextChanged" AutomationProperties.AutomationId="PluginSearch" AutomationProperties.Name="Search plugins or authors"/>
            <ComboBox x:Name="CategoryFilter" Grid.Row="1" Grid.ColumnSpan="2" Width="220" HorizontalAlignment="Left" Header="Category" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" AutomationProperties.AutomationId="PluginCategoryFilter" AutomationProperties.Name="Filter plugins by category" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowHeader">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PluginSearchBox.(Grid.Row)" Value="1" />
                            <Setter Target="PluginSearchBox.(Grid.Column)" Value="0" />
                            <Setter Target="PluginSearchBox.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="PluginSearchBox.Width" Value="NaN" />
                            <Setter Target="PluginSearchBox.HorizontalAlignment" Value="Stretch" />
                            <Setter Target="CategoryFilter.(Grid.Row)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideHeader">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>

        <!-- Error Notification Banner -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Title="Plugin Store Notice"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsClosable="False"
                 AutomationProperties.LiveSetting="Assertive" />

        <!-- Loading Indicator -->
        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Center" AutomationProperties.Name="Loading plugin catalog"/>

        <!-- Virtualized Plugins List -->
        <ListView Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                  SelectionMode="None"
                  AutomationProperties.AutomationId="PluginCatalog"
                  AutomationProperties.Name="Plugins list">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0,0,0,12"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PluginCardViewModel">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid RowSpacing="8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                    <Border Grid.Column="1" VerticalAlignment="Top" Background="{ThemeResource AccentTealSubtleBrush}" BorderBrush="{ThemeResource AccentTealBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind StatusBadgeText}" FontFamily="Cascadia Code" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentTealBrush}" />
                                    </Border>
                                    <Border Grid.Column="2" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind PublisherTrustBadgeText}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                    <TextBlock Text="{x:Bind Category}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind Author}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind Version}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Content="Details" Click="DetailsButton_Click" Tag="{x:Bind}" AutomationProperties.Name="View plugin details"/>
                                    
                                    <!-- Online Plugin Actions -->
                                    <Button Content="Install" Visibility="{x:Bind local:PluginStorePage.BoolToVisibility(CanInstall), Mode=OneTime}" Click="InstallButton_Click" Tag="{x:Bind}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Review and install plugin"/>
                                    
                                    <!-- Installed Plugin Actions -->
                                    <Button Content="Enable" Visibility="{x:Bind local:PluginStorePage.BoolToVisibility(CanEnable), Mode=OneTime}" Click="EnableButton_Click" Tag="{x:Bind}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Enable plugin"/>
                                    <Button Content="Disable" Visibility="{x:Bind local:PluginStorePage.BoolToVisibility(CanDisable), Mode=OneTime}" Click="DisableButton_Click" Tag="{x:Bind}" AutomationProperties.Name="Disable plugin"/>
                                    <Button Content="Uninstall" Visibility="{x:Bind local:PluginStorePage.BoolToVisibility(CanUninstall), Mode=OneTime}" Click="UninstallButton_Click" Tag="{x:Bind}" AutomationProperties.Name="Uninstall plugin"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <InfoBar Grid.Row="3" Margin="12" VerticalAlignment="Top" IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="No plugins found" Message="Try a different search or category." AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
