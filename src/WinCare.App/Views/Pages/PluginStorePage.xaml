<Page
    x:Class="WinCare.App.Views.Pages.PluginStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinCare.App.Views.Pages"
    xmlns:vm="using:WinCare.App.ViewModels.Pages"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">

    <Grid Padding="32,24,32,32" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="18">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Extensions" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock MaxWidth="760" HorizontalAlignment="Left" Text="Add optional features and manage what's already installed." Style="{StaticResource PageDescriptionTextStyle}" />
            </StackPanel>

            <AutoSuggestBox x:Name="PluginSearchBox" Grid.Column="1" Width="280" VerticalAlignment="Center" PlaceholderText="Search extensions or authors" QueryIcon="Find" TextChanged="SearchBox_TextChanged" AutomationProperties.AutomationId="PluginSearch" AutomationProperties.Name="Search extensions or authors"/>
            <ComboBox x:Name="CategoryFilter" Grid.Row="1" Grid.ColumnSpan="2" Width="220" HorizontalAlignment="Left" Header="Category" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" AutomationProperties.AutomationId="PluginCategoryFilter" AutomationProperties.Name="Filter extensions by category" />
        </Grid>

        <Expander Grid.Row="1"
                  Header="Online catalog"
                  IsExpanded="False"
                  Visibility="{x:Bind local:PluginStorePage.BoolToVisibility(ViewModel.HasCatalogStatus), Mode=OneWay}"
                  AutomationProperties.AutomationId="PluginCatalogStatus"
                  AutomationProperties.Name="Online extension catalog status">
            <TextBlock Style="{StaticResource RowSecondaryTextStyle}"
                       Text="{x:Bind ViewModel.CatalogStatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap" />
        </Expander>

        <InfoBar Grid.Row="2"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Title="Couldn't load extensions"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsClosable="False"
                 AutomationProperties.LiveSetting="Assertive">
            <InfoBar.ActionButton>
                <Button Content="Try again" Style="{StaticResource QuietButtonStyle}" Click="RetryCatalog_Click" IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" Visibility="{x:Bind local:PluginStorePage.BoolToVisibility(ViewModel.HasCatalogError), Mode=OneWay}" AutomationProperties.AutomationId="PluginCatalogRetry" AutomationProperties.Name="Retry extension catalog connection" />
            </InfoBar.ActionButton>
        </InfoBar>

        <StackPanel Grid.Row="3" Spacing="8" Visibility="{x:Bind local:PluginStorePage.BoolToVisibility(ViewModel.IsLoading), Mode=OneWay}" AutomationProperties.LiveSetting="Polite">
            <TextBlock Text="Checking for extensions…" Style="{StaticResource RowSecondaryTextStyle}" />
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}" AutomationProperties.Name="Loading extension catalog" />
        </StackPanel>

        <ListView Grid.Row="4"
                  ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                  SelectionMode="None"
                  AutomationProperties.AutomationId="PluginCatalog"
                  AutomationProperties.Name="Extensions list">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0,0,0,12"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PluginCardViewModel">
                    <Border Background="{ThemeResource CardSurfaceBrush}"
                            BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusCardOuter}" Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleTextStyle}" VerticalAlignment="Center" />
                                    <ContentControl Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Template="{StaticResource StatusPillTemplate}" Background="{ThemeResource AccentTealSubtleBrush}" BorderBrush="{ThemeResource AccentTealBrush}" Content="{x:Bind StatusBadgeText}" Foreground="{ThemeResource AccentTealBrush}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource RowSecondaryTextStyle}" />
                                <TextBlock Text="{x:Bind PublisherTrustBadgeText}" Style="{StaticResource RowSecondaryTextStyle}" />
                                <StackPanel Spacing="4" Margin="0,2,0,0">
                                    <TextBlock Text="{x:Bind Category}" Style="{StaticResource RowSecondaryTextStyle}" />
                                    <TextBlock Text="{x:Bind Author}" Style="{StaticResource RowSecondaryTextStyle}" />
                                    <TextBlock Text="{x:Bind Version}" Style="{StaticResource TelemetryTextStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Details" Click="DetailsButton_Click" Tag="{x:Bind}" Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="{x:Bind DetailsAccessibleName}"/>
                                <Button Content="Add" Visibility="{x:Bind local:PluginStorePage.BoolToVisibility(CanInstall), Mode=OneTime}" Click="InstallButton_Click" Tag="{x:Bind}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="{x:Bind InstallAccessibleName}"/>
                                <Button Content="Enable" Visibility="{x:Bind local:PluginStorePage.BoolToVisibility(CanEnable), Mode=OneTime}" Click="EnableButton_Click" Tag="{x:Bind}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="{x:Bind EnableAccessibleName}"/>
                                <Button Content="Disable" Visibility="{x:Bind local:PluginStorePage.BoolToVisibility(CanDisable), Mode=OneTime}" Click="DisableButton_Click" Tag="{x:Bind}" Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="{x:Bind DisableAccessibleName}"/>
                                <Button Content="Uninstall" Visibility="{x:Bind local:PluginStorePage.BoolToVisibility(CanUninstall), Mode=OneTime}" Click="UninstallButton_Click" Tag="{x:Bind}" Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="{x:Bind UninstallAccessibleName}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar Grid.Row="4" Margin="12" VerticalAlignment="Top" IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="No extensions found" Message="Try another search or category. Installed extensions stay available even when the online list is offline." AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
