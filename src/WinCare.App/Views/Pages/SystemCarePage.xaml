<Page
    x:Class="WinCare.App.Views.Pages.SystemCarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinCare.App.Views"
    xmlns:controls="using:WinCare.App.Controls"
    NavigationCacheMode="Required">
    <Grid Padding="28,28,28,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeaderControl
            Title="System care"
            Description="Clean up, improve responsiveness, manage apps, and maintain Windows." />

        <SelectorBar
            x:Name="SectionSelector"
            Grid.Row="1"
            SelectionChanged="SectionSelector_SelectionChanged"
            AutomationProperties.AutomationId="SystemCarePageTabs"
            AutomationProperties.Name="System care sections">
            <SelectorBarItem Text="Clean up" AutomationProperties.Name="Clean up" />
            <SelectorBarItem Text="Performance" AutomationProperties.Name="Performance" />
            <SelectorBarItem Text="Apps &amp; startup" AutomationProperties.Name="Apps and startup" />
            <SelectorBarItem Text="Network &amp; updates" AutomationProperties.Name="Network and updates" />
            <SelectorBarItem Text="Routines &amp; maintenance" AutomationProperties.Name="Routines and maintenance" />
        </SelectorBar>

        <Grid Grid.Row="2" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:MemoryTopologyAtlas
                x:Name="MemoryAtlas"
                Margin="0,0,0,4"
                Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(ViewModel.IsPerformanceSection), Mode=OneWay}" />

            <controls:CareToolList Grid.Row="1" ViewModel="{x:Bind ViewModel}" />
        </Grid>
    </Grid>
</Page>
