<Page
    x:Class="WinCare.App.Views.Pages.SystemCarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinCare.App.Views"
    xmlns:vm="using:WinCare.App.ViewModels.Pages"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <Grid Padding="32,24,32,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="System care" />
            <TextBlock MaxWidth="760" HorizontalAlignment="Left" Style="{StaticResource PageDescriptionTextStyle}" Text="Clean up, improve responsiveness, manage apps, and maintain Windows." />
        </StackPanel>

        <SelectorBar
            x:Name="SectionSelector"
            Grid.Row="1"
            SelectionChanged="SectionSelector_SelectionChanged"
            AutomationProperties.AutomationId="SystemCarePageTabs"
            AutomationProperties.Name="System care sections">
            <SelectorBarItem Text="Clean up" AutomationProperties.Name="Clean up" />
            <SelectorBarItem Text="Performance" AutomationProperties.Name="Performance" />
            <SelectorBarItem Text="Apps &amp; startup" AutomationProperties.Name="Apps and startup" />
            <SelectorBarItem Text="Network &amp; updates" AutomationProperties.Name="Network and updates" />
            <SelectorBarItem Text="Routines" AutomationProperties.Name="Routines" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        Height="42"
                        Padding="16,0"
                        ColumnSpacing="16"
                        Background="{ThemeResource SurfaceSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="Item" />
                        <TextBlock x:Name="DescriptionHeader" Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}" Text="What it does" />
                        <TextBlock x:Name="StateHeader" Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}" Text="State" />
                        <TextBlock x:Name="NotesHeader" Grid.Column="3" Style="{StaticResource ColumnHeaderTextStyle}" Text="Notes" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.CurrentRows, Mode=OneWay}"
                        SelectionMode="None"
                        AutomationProperties.AutomationId="SystemCarePageRows"
                        AutomationProperties.Name="System care information">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="68" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageRow">
                                <Grid Padding="16,10">
                                    <Grid
                                        ColumnSpacing="16"
                                        Visibility="{x:Bind views:LayoutVisibility.InvertBoolToVisibility(IsCompact), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Description}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind State, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Detail, Mode=OneWay}" TextWrapping="Wrap" />
                                    </Grid>
                                    <StackPanel
                                        Spacing="5"
                                        Visibility="{x:Bind views:LayoutVisibility.BoolToVisibility(IsCompact), Mode=OneWay}">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Description}" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RowSecondaryTextStyle}" Text="State" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind State, Mode=OneWay}" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Style="{StaticResource RowSecondaryTextStyle}" Text="Notes" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Detail, Mode=OneWay}" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <InfoBar
                Margin="12"
                VerticalAlignment="Top"
                IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                IsClosable="False"
                Severity="Informational"
                Title="Nothing to show"
                Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
