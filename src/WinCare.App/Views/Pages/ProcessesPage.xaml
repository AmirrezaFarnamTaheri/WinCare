<Page
    x:Class="WinCare.App.Views.Pages.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinCare.App.Controls"
    xmlns:local="using:WinCare.App.Views.Pages"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <Grid x:Name="PageLayout" Padding="32,28,32,28" MaxWidth="1320" RowSpacing="18"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:PageHeaderControl Title="Processes"
            Description="See what's running, compare CPU and memory use, and close a task when needed." />

        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Padding="18">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="22">
                <StackPanel Spacing="4">
                    <TextBlock Text="Running tasks" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock x:Name="TaskCount" Text="—" Style="{StaticResource MetricTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Last updated" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock x:Name="UpdatedTime" Text="Not yet" Style="{StaticResource MetricTextStyle}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Windows Task Manager"
                        Click="OpenTaskManager_Click" Style="{StaticResource QuietButtonStyle}"
                        VerticalAlignment="Center" AutomationProperties.Name="Open Windows Task Manager" />
            </Grid>
        </Border>

        <Grid x:Name="ActionsGrid" Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
            <TextBox x:Name="FilterInput" PlaceholderText="Find a process or PID"
                     MinHeight="44" TextChanged="FilterInput_TextChanged"
                     AutomationProperties.Name="Search running processes" />
            <ComboBox x:Name="SortPicker" Grid.Column="1" Width="155" MinHeight="44"
                      SelectionChanged="SortPicker_SelectionChanged"
                      AutomationProperties.Name="Sort processes">
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Memory" />
                <ComboBoxItem Content="CPU" />
                <ComboBoxItem Content="PID" />
            </ComboBox>
            <CheckBox x:Name="LiveRefresh" Grid.Column="2" Content="Live" IsChecked="True"
                      VerticalAlignment="Center" Checked="LiveRefresh_Changed" Unchecked="LiveRefresh_Changed"
                      AutomationProperties.Name="Update process readings automatically" />
            <Button Grid.Column="3" Content="Refresh" Click="Refresh_Click"
                    Style="{StaticResource QuietButtonStyle}"
                    AutomationProperties.Name="Refresh process readings" />
        </Grid>
        <InfoBar x:Name="TaskNotice" Grid.Row="3" Title="Processes" IsOpen="False" IsClosable="True"
                 Severity="Informational" AutomationProperties.LiveSetting="Polite" />

        <Border Grid.Row="4" Style="{StaticResource SurfaceBorderStyle}">
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="16,12" Background="{ThemeResource SurfaceSecondaryBrush}" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Task" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock x:Name="ShownCount" Grid.Column="1" Text="No tasks loaded"
                               Style="{StaticResource RowSecondaryTextStyle}" VerticalAlignment="Center" />
                </Grid>
                <ListView x:Name="ProcessList" Grid.Row="1" SelectionMode="Single"
                          ItemsSource="{x:Bind VisibleRows, Mode=OneWay}"
                          AutomationProperties.Name="Running processes with CPU and memory readings">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="74" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ProcessDisplayRow">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" Padding="8,10">
                                <Border Width="40" Height="40" Background="{ThemeResource AccentChromeSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusControl}">
                                    <FontIcon Glyph="&#xE9CE;" Foreground="{ThemeResource AccentChromeBrush}" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleTextStyle}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind PidLabel}" Style="{StaticResource RowSecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" MinWidth="92">
                                    <TextBlock Text="{x:Bind MemoryLabel, Mode=OneWay}" Style="{StaticResource RowTitleTextStyle}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind CpuLabel, Mode=OneWay}" Style="{StaticResource RowSecondaryTextStyle}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="End task" Tag="{x:Bind}" Click="EndTask_Click"
                                        IsEnabled="{x:Bind CanEnd}" VerticalAlignment="Center"
                                        Style="{StaticResource QuietButtonStyle}"
                                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <StackPanel Grid.Row="5" Spacing="4">
            <TextBlock Text="CPU is a sample over time; memory is each process's working set. Values may be unavailable for protected tasks."
                       Style="{StaticResource FieldHintTextStyle}" />
            <TextBlock x:Name="FooterText" Text="Live readings update every five seconds. Ending a task requires confirmation."
                       Style="{StaticResource RowSecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Page>
