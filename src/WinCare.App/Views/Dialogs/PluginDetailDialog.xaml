<ContentDialog
    x:Class="WinCare.App.Views.Dialogs.PluginDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Plugin Details &amp; Permissions"
    PrimaryButtonText="Install Plugin"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <StackPanel Width="440" Spacing="16">
        <!-- Header & Metadata -->
        <Grid ColumnDefinitions="Auto,*">
            <Border Width="64" Height="64" CornerRadius="8" Background="{ThemeResource SystemControlBackgroundComponentMeshBrush}" Margin="0,0,16,0">
                <FontIcon Glyph="&#xE74C;" FontSize="32" Foreground="{ThemeResource AccentTealBrush}"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="PluginNameText" FontSize="18" FontWeight="SemiBold" Text="Plugin Name"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="PluginAuthorText" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="by Author"/>
                    <TextBlock FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="•"/>
                    <TextBlock x:Name="PluginVersionText" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="v1.0.0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Description -->
        <TextBlock x:Name="PluginDescriptionText" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" Text="Plugin description text goes here."/>

        <!-- Category & Published Date -->
        <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Category" FontSize="11" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock x:Name="PluginCategoryText" FontSize="13" FontWeight="Medium" Text="General"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Published" FontSize="11" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock x:Name="PluginPublishedText" FontSize="13" FontWeight="Medium" Text="2026-08-14"/>
            </StackPanel>
        </Grid>

        <!-- Security Permissions Audit Section -->
        <Border BorderThickness="1" BorderBrush="{ThemeResource SystemControlBackgroundListLowBrush}" CornerRadius="6" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource AccentTealBrush}"/>
                    <TextBlock Text="Requested Permissions" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
                <ItemsControl x:Name="PermissionsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTealBrush}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind}" FontSize="12" FontFamily="Consolas"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Commands Provided -->
        <StackPanel Spacing="4">
            <TextBlock Text="Commands Provided:" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock x:Name="CommandsProvidedText" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" Text="None"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
