<ContentDialog
    x:Class="WinCare.App.Views.Dialogs.PluginDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Extension details"
    PrimaryButtonText="Install"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    CornerRadius="{StaticResource RadiusControl}"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="460" Spacing="24">
        <Grid ColumnDefinitions="Auto,*">
            <Border Width="64" Height="64" CornerRadius="{StaticResource RadiusControl}" Background="{ThemeResource AccentChromeSubtleBrush}" BorderBrush="{ThemeResource AccentChromeBrush}" BorderThickness="1" Margin="0,0,16,0">
                <FontIcon Glyph="&#xE74C;" FontSize="32" Foreground="{ThemeResource AccentChromeBrush}" AutomationProperties.AccessibilityView="Raw"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="PluginNameText" Style="{StaticResource AppTitleTextStyle}" Text="Extension name"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="PluginAuthorText" Style="{StaticResource RowSecondaryTextStyle}" Text="by Author"/>
                    <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="•"/>
                    <TextBlock x:Name="PluginVersionText" Style="{StaticResource TelemetryTextStyle}" Text="v1.0.0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="PluginDescriptionText" Style="{StaticResource BodyTextStyle}" Text="Extension description."/>

        <Border BorderThickness="1" BorderBrush="{ThemeResource WarningBrush}" CornerRadius="{StaticResource RadiusControl}" Padding="10" Background="{ThemeResource SurfaceSecondaryBrush}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Grid.Column="1" Text="Extensions run on your PC with your account's permissions. Install only from authors you trust." Style="{StaticResource BodyTextStyle}"/>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0"><TextBlock Text="Category" Style="{StaticResource FieldLabelTextStyle}"/><TextBlock x:Name="PluginCategoryText" Style="{StaticResource BodyTextStyle}" Text="General"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Published" Style="{StaticResource FieldLabelTextStyle}"/><TextBlock x:Name="PluginPublishedText" Style="{StaticResource BodyTextStyle}" Text="2026-08-14"/></StackPanel>
        </Grid>

        <Border BorderThickness="1" BorderBrush="{ThemeResource BorderSubtleBrush}" CornerRadius="{StaticResource RadiusControl}" Padding="12" Background="{ThemeResource CardSurfaceBrush}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource AccentChromeBrush}" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="What it can access" Style="{StaticResource FieldLabelTextStyle}"/></StackPanel>
                <ItemsControl x:Name="PermissionsItemsControl"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Grid ColumnDefinitions="Auto,*" Margin="0,2"><FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentChromeBrush}" Margin="0,0,8,0" AutomationProperties.AccessibilityView="Raw"/><TextBlock Grid.Column="1" Text="{x:Bind}" Style="{StaticResource TelemetryTextStyle}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="Extensions use the same Windows permissions as your account." Style="{StaticResource FieldHintTextStyle}" />
            </StackPanel>
        </Border>

        <Border BorderThickness="1" BorderBrush="{ThemeResource BorderSubtleBrush}" CornerRadius="{StaticResource RadiusControl}" Padding="10" Background="{ThemeResource CardSurfaceBrush}">
            <Grid ColumnDefinitions="Auto,*"><FontIcon Glyph="&#xE8D7;" FontSize="14" Foreground="{ThemeResource AccentChromeBrush}" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Publisher" Style="{StaticResource FieldLabelTextStyle}"/><TextBlock x:Name="PublisherTrustText" Style="{StaticResource BodyTextStyle}" Text="Community"/></StackPanel></Grid>
        </Border>

        <Border x:Name="RevocationBanner" Visibility="Collapsed" BorderThickness="1" BorderBrush="{ThemeResource DangerBrush}" CornerRadius="{StaticResource RadiusControl}" Padding="10" Background="{ThemeResource SurfaceSecondaryBrush}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><FontIcon Glyph="&#xEB90;" FontSize="16" Foreground="{ThemeResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw"/><TextBlock Grid.Column="1" x:Name="RevocationReasonText" Text="This extension was blocked for security reasons." Style="{StaticResource RowSecondaryTextStyle}" Foreground="{ThemeResource DangerBrush}"/></Grid>
        </Border>
        <TextBlock Text="You can install this extension only when its catalog and package checks pass." Style="{StaticResource FieldHintTextStyle}" />

        <StackPanel Spacing="4"><TextBlock Text="Tools included" Style="{StaticResource FieldLabelTextStyle}"/><TextBlock x:Name="CommandsProvidedText" Style="{StaticResource RowSecondaryTextStyle}" Text="None"/></StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
