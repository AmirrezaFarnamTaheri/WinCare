<Page
    x:Class="WinCare.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    SizeChanged="Shell_SizeChanged">
    <NavigationView
        x:Name="PrimaryNavigation"
        IsBackButtonVisible="Visible"
        IsBackEnabled="False"
        BackRequested="PrimaryNavigation_BackRequested"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        PaneDisplayMode="LeftCompact"
        PaneTitle="WinCare"
        OpenPaneLength="244"
        CompactPaneLength="56"
        Background="{ThemeResource PageBackgroundBrush}"
        SelectionChanged="PrimaryNavigation_SelectionChanged"
        AutomationProperties.AutomationId="PrimaryNavigation"
        AutomationProperties.Name="Primary navigation">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="NavHome" Content="Home" Tag="home" AutomationProperties.AutomationId="NavHome" AutomationProperties.Name="Home">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavCheckup" Content="Checkup" Tag="checkup" AutomationProperties.AutomationId="NavCheckup" AutomationProperties.Name="Checkup">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemHeader Content="Care" />
            <NavigationViewItem x:Uid="NavSystemCare" Content="System care" Tag="system-care" AutomationProperties.AutomationId="NavSystemCare" AutomationProperties.Name="System care">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavSecurity" Content="Security" Tag="security" AutomationProperties.AutomationId="NavSecurity" AutomationProperties.Name="Security">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xEA18;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavRepairRecovery" Content="Repair &amp; recovery" Tag="repair-recovery" AutomationProperties.AutomationId="NavRepairRecovery" AutomationProperties.Name="Repair and recovery">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE777;" /></NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemHeader Content="More" />
            <NavigationViewItem x:Uid="NavAllTools" Content="Power tools" Tag="all-tools" AutomationProperties.AutomationId="NavAllTools" AutomationProperties.Name="Power tools">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavActivity" Content="Activity" Tag="activity" AutomationProperties.AutomationId="NavActivity" AutomationProperties.Name="Activity">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Uid="NavPluginStore" Content="Extensions" Tag="plugin-store" AutomationProperties.AutomationId="NavPluginStore" AutomationProperties.Name="Extensions">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xEA86;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavAiDoctor" Content="Troubleshoot" Tag="ai-doctor" AutomationProperties.AutomationId="NavAiDoctor" AutomationProperties.Name="Troubleshoot">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE730;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavSettings" Content="Settings" Tag="settings" AutomationProperties.AutomationId="NavSettings" AutomationProperties.Name="Settings">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavHelp" Content="Help" Tag="help" AutomationProperties.AutomationId="NavHelp" AutomationProperties.Name="Help">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
    </NavigationView>
</Page>
