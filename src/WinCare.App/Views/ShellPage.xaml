<Page
    x:Class="WinCare.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    SizeChanged="Shell_SizeChanged"
    Background="{ThemeResource PageBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Window TitleBar Ribbon & Global Search Command Bar (Ctrl+K) -->
        <Grid Grid.Row="0" Height="48" Padding="16,0,16,0" ColumnDefinitions="Auto,*,Auto"
              Background="{ThemeResource TitleBarBackgroundBrush}">
            <!-- Brand Badge -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE90F;" Foreground="{ThemeResource AccentChromeBrush}" FontSize="18" />
                <TextBlock Text="WinCare" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                <Border Background="{ThemeResource SurfaceSecondaryBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="v5.0 Native" FontSize="11" FontFamily="Cascadia Code" Foreground="{ThemeResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- Global Command Palette Launcher (Ctrl+K) -->
            <Button Grid.Column="1" HorizontalAlignment="Center" Width="440" Height="34"
                    Style="{StaticResource QuietButtonStyle}" Click="OpenCommandPalette_Click"
                    AutomationProperties.Name="Global command search">
                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                    <FontIcon Glyph="&#xE721;" FontSize="12" Margin="0,0,8,0" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Search tools, commands, or paste magnet URI..." FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+K" FontSize="10" FontFamily="Cascadia Code" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Border>
                </Grid>
            </Button>

            <!-- Right Spacer for Windows Caption Controls -->
            <StackPanel Grid.Column="2" Width="40" />
        </Grid>

        <!-- Main Body: 5-Workspace Adaptive Navigation Rail + Viewport -->
        <NavigationView
            x:Name="PrimaryNavigation" Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="False"
            BackRequested="PrimaryNavigation_BackRequested"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="LeftCompact"
            CompactPaneLength="56"
            OpenPaneLength="220"
            Background="Transparent"
            SelectionChanged="PrimaryNavigation_SelectionChanged"
            AutomationProperties.AutomationId="PrimaryNavigation"
            AutomationProperties.Name="Primary navigation">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavHome" Content="Home" Tag="home" ToolTipService.ToolTip="Home"
                                    AutomationProperties.AutomationId="NavHome" AutomationProperties.Name="Home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavCheckup" Content="Checkup" Tag="checkup" ToolTipService.ToolTip="Checkup"
                                    AutomationProperties.AutomationId="NavCheckup" AutomationProperties.Name="Checkup">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSystemCare" Content="System care" Tag="system-care" ToolTipService.ToolTip="System care"
                                    AutomationProperties.AutomationId="NavSystemCare" AutomationProperties.Name="System care">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSecurity" Content="Security" Tag="security" ToolTipService.ToolTip="Security"
                                    AutomationProperties.AutomationId="NavSecurity" AutomationProperties.Name="Security">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavRepairRecovery" Content="Repair &amp; recovery" Tag="repair-recovery" ToolTipService.ToolTip="Repair &amp; recovery"
                                    AutomationProperties.AutomationId="NavRepairRecovery" AutomationProperties.Name="Repair &amp; recovery">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavAllTools" Content="Power tools" Tag="all-tools" ToolTipService.ToolTip="Power tools"
                                    AutomationProperties.AutomationId="NavAllTools" AutomationProperties.Name="Power tools">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavActivity" Content="Activity" Tag="activity" ToolTipService.ToolTip="Activity"
                                    AutomationProperties.AutomationId="NavActivity" AutomationProperties.Name="Activity">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavDownloads" Content="Downloads" Tag="downloads" ToolTipService.ToolTip="Downloads"
                                    AutomationProperties.AutomationId="NavDownloads" AutomationProperties.Name="Downloads">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavStorageBrowser" Content="Files &amp; storage" Tag="storage-browser" ToolTipService.ToolTip="Files &amp; storage"
                                    AutomationProperties.AutomationId="NavStorageBrowser" AutomationProperties.Name="Files &amp; storage">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavProcesses" Content="Processes" Tag="processes" ToolTipService.ToolTip="Processes"
                                    AutomationProperties.AutomationId="NavProcesses" AutomationProperties.Name="Processes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9CE;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavAiDoctor" Content="Troubleshoot" Tag="ai-doctor" ToolTipService.ToolTip="Troubleshoot"
                                    AutomationProperties.AutomationId="NavAiDoctor" AutomationProperties.Name="Troubleshoot">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavPluginStore" Content="Extensions" Tag="plugin-store" ToolTipService.ToolTip="Extensions"
                                    AutomationProperties.AutomationId="NavPluginStore" AutomationProperties.Name="Extensions">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA86;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSettings" Content="Settings" Tag="settings" ToolTipService.ToolTip="Settings"
                                    AutomationProperties.AutomationId="NavSettings" AutomationProperties.Name="Settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavHelp" Content="Help" Tag="help" ToolTipService.ToolTip="Help"
                                    AutomationProperties.AutomationId="NavHelp" AutomationProperties.Name="Help">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>

        <!-- System Status Bar -->
        <Border Grid.Row="2" Height="30" Background="{ThemeResource TitleBarBackgroundBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource BorderSubtleBrush}" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SuccessBrush}" />
                    <TextBlock Text="Kernel Core: Synced (ABI v1)" FontSize="11" FontFamily="Cascadia Code" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Memory: Nominal" FontSize="11" FontFamily="Cascadia Code" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="Swarm Engine: Ready" FontSize="11" FontFamily="Cascadia Code" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
