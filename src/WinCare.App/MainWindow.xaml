<Window
    x:Class="WinCare.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinCare.App.Views"
    xmlns:vm="using:WinCare.App.ViewModels"
    Title="WinCare">
    <Grid x:Name="WindowRoot" Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="20,0,138,0"
            Background="{ThemeResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SearchColumn" Width="420" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="26" Height="26" Source="Assets/Square44x44Logo.png" />
                <TextBlock x:Name="AppTitleText" Style="{StaticResource AppTitleTextStyle}" Text="WinCare" />
            </StackPanel>

            <AutoSuggestBox
                x:Name="GlobalSearchBox"
                Grid.Column="2"
                Height="40"
                VerticalAlignment="Center"
                PlaceholderText="Search WinCare (Ctrl+K)"
                TextChanged="GlobalSearchBox_TextChanged"
                QuerySubmitted="GlobalSearchBox_QuerySubmitted"
                AutomationProperties.AutomationId="GlobalSearch"
                AutomationProperties.Name="Search WinCare">
                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchKeyboardAccelerator_Invoked" />
                </AutoSuggestBox.KeyboardAccelerators>
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GlobalSearchSuggestion">
                        <Grid Padding="4,6" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" />
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind KindLabel}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </Grid>

        <views:ShellPage x:Name="Shell" Grid.Row="1" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactTitleBar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchColumn.Width" Value="220" />
                        <Setter Target="AppTitleText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StandardTitleBar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchColumn.Width" Value="420" />
                        <Setter Target="AppTitleText.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
