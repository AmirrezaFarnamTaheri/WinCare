<Window
    x:Class="WinCare.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinCare.App.Views"
    xmlns:nav="using:WinCare.Application.Navigation"
    Title="WinCare">
    <Grid x:Name="WindowRoot" Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="24,0,138,0"
            Background="{ThemeResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SearchColumn" Width="*" MinWidth="300" MaxWidth="500" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Image Width="28" Height="28" Source="Assets/Square44x44Logo.png" />
                <TextBlock x:Name="AppTitleText" Style="{StaticResource AppTitleTextStyle}" Text="WinCare 4.0" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                <Border x:Name="TitleStatusBadge"
                        Background="{ThemeResource AccentChromeSubtleBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}"
                        Padding="8,3"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="DISPATCHER · ACTIVE"
                                   FontFamily="{StaticResource TelemetryFontFamily}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentChromeBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <AutoSuggestBox
                x:Name="GlobalSearchBox"
                Grid.Column="2"
                MinHeight="48"
                VerticalAlignment="Center"
                PlaceholderText="Search tasks and tools (Ctrl+K)"
                TextChanged="GlobalSearchBox_TextChanged"
                QuerySubmitted="GlobalSearchBox_QuerySubmitted"
                AutomationProperties.AutomationId="GlobalSearch"
                AutomationProperties.Name="Search WinCare">
                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchKeyboardAccelerator_Invoked" />
                </AutoSuggestBox.KeyboardAccelerators>
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="nav:GlobalSearchSuggestion">
                        <Grid Padding="8,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" FontWeight="Medium" />
                                <TextBlock Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" Opacity="0.7" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource RowSecondaryTextStyle}" Text="{x:Bind KindLabel}" VerticalAlignment="Center" Opacity="0.5" />
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </Grid>

        <views:ShellPage x:Name="Shell" Grid.Row="1" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactTitleBar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AppTitleText.Visibility" Value="Collapsed" />
                        <Setter Target="TitleStatusBadge.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StandardTitleBar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AppTitleText.Visibility" Value="Visible" />
                        <Setter Target="TitleStatusBadge.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
