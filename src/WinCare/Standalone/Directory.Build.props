<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <UseAppHost>true</UseAppHost>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\$(MSBuildProjectName)\</BaseOutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ErrorOnDuplicatePublishOutputFiles>true</ErrorOnDuplicatePublishOutputFiles>
    <StartupObject>WinCareEntryPoint</StartupObject>
    <RestoreLockedMode Condition="Exists('$(MSBuildThisFileDirectory)packages.lock.json')">true</RestoreLockedMode>
    <WinCareApplicationIcon>$(MSBuildThisFileDirectory)..\Data\Gui\WinCare.ico</WinCareApplicationIcon>
    <ApplicationIcon>$(WinCareApplicationIcon)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="WinCare.GlobalUsings.cs" />
    <Compile Include="WinCare.EntryPoint.cs" />
    <Compile Include="WinCare.Host.cs" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.18" />
    <PackageReference Include="Microsoft.PowerShell.ConsoleHost" Version="7.4.18" />
  </ItemGroup>

  <Target Name="ValidateAndEmbedWinCarePayload" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(WinCareApplicationIcon)' == ''" Text="WinCareApplicationIcon is required." />
    <Error Condition="!Exists('$(WinCareApplicationIcon)')" Text="WinCareApplicationIcon does not identify an existing ICO file." />
    <Error Condition="$([System.String]::Copy('$(WinCareApplicationIcon)').EndsWith('.ico', System.StringComparison.OrdinalIgnoreCase)) != 'True'" Text="WinCareApplicationIcon must identify an .ico file." />
    <Error Condition="'$(WinCarePayloadPath)' == ''" Text="WinCarePayloadPath is required." />
    <Error Condition="!Exists('$(WinCarePayloadPath)')" Text="WinCarePayloadPath does not identify an existing payload ZIP." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(WinCarePayloadSha256)', '^[0-9A-Fa-f]{64}$')) != 'True'" Text="WinCarePayloadSha256 must be exactly 64 hexadecimal characters." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(WinCarePayloadManifestSha256)', '^[0-9A-Fa-f]{64}$')) != 'True'" Text="WinCarePayloadManifestSha256 must be exactly 64 hexadecimal characters." />
    <PropertyGroup>
      <_WinCareExpectedPayloadSha256>$([System.String]::Copy('$(WinCarePayloadSha256)').ToLowerInvariant())</_WinCareExpectedPayloadSha256>
      <_WinCareExpectedManifestSha256>$([System.String]::Copy('$(WinCarePayloadManifestSha256)').ToLowerInvariant())</_WinCareExpectedManifestSha256>
    </PropertyGroup>
    <GetFileHash Files="$(WinCarePayloadPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WinCarePayloadHash" />
    </GetFileHash>
    <Error Condition="'%(_WinCarePayloadHash.FileHash)' != '$(_WinCareExpectedPayloadSha256)'" Text="Standalone payload SHA-256 does not match WinCarePayloadSha256." />
    <ItemGroup>
      <EmbeddedResource Include="$(WinCarePayloadPath)" LogicalName="WinCare.Payload.zip" />
      <AssemblyMetadata Include="WinCarePayloadSha256" Value="$(_WinCareExpectedPayloadSha256)" />
      <AssemblyMetadata Include="WinCarePayloadManifestSha256" Value="$(_WinCareExpectedManifestSha256)" />
    </ItemGroup>
  </Target>
</Project>
