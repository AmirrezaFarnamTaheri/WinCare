<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow"
        Title="WinCare Operations Dashboard"
        Height="800" Width="1200" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="WINCARE OPERATIONS DASHBOARD" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                    <TextBlock Text=" | LOCAL OFFLINE SHELL" FontFamily="Consolas" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <WebBrowser x:Name="DashboardBrowser" Grid.Row="1"/>

        <Border Grid.Row="2" Background="#020617" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="STATUS: AWAITING DASHBOARD DATA | TELEMETRY: NOT CONNECTED"
                           FontFamily="Consolas" FontSize="11" Foreground="#94A3B8"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
