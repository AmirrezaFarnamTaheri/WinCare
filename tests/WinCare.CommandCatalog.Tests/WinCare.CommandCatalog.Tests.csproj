<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WinCare.CommandCatalog\WinCare.CommandCatalog.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Test fixtures for CommandPackCatalog: the resource name must end with
      commands.<packId>.json, matching CommandPackCatalog.FragmentResourceSuffix.
      The LogicalName pins the default namespace prefix so the suffix contract is exercised exactly.
    -->
    <EmbeddedResource Include="Data\commands.testpack.json" LogicalName="WinCare.CommandCatalog.Tests.Data.commands.testpack.json" />
    <EmbeddedResource Include="Data\commands.mismatch.json" LogicalName="WinCare.CommandCatalog.Tests.Data.commands.mismatch.json" />
    <EmbeddedResource Include="Data\commands.unschema.json" LogicalName="WinCare.CommandCatalog.Tests.Data.commands.unschema.json" />
    <EmbeddedResource Include="Data\commands.nometa.json" LogicalName="WinCare.CommandCatalog.Tests.Data.commands.nometa.json" />
    <EmbeddedResource Include="Data\commands.duplicate.json" LogicalName="WinCare.CommandCatalog.Tests.Data.commands.duplicate.json" />
    <EmbeddedResource Include="Data\commands.ambiguous.json" LogicalName="WinCare.CommandCatalog.Tests.Data.commands.ambiguous.json" />
    <EmbeddedResource Include="Data\commands.ambiguous.alt.json" LogicalName="WinCare.CommandCatalog.Tests.Data.commands.ambiguous.alt.json" />
  </ItemGroup>
</Project>
