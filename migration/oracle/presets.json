{
  "schemaVersion": 1,
  "presets": [
    {
      "id": "safe",
      "title": "Safe usability baseline",
      "description": "Low-risk visibility and usability improvements.",
      "ruleIds": [
        "explorer.show-extensions",
        "explorer.launch-this-pc",
        "performance.menu-delay"
      ]
    },
    {
      "id": "privacy",
      "title": "Privacy baseline",
      "description": "Reversible privacy controls without disabling security services.",
      "ruleIds": [
        "privacy.advertising-id",
        "privacy.tailored-experiences",
        "privacy.disable-suggestions",
        "privacy.disable-feedback-prompts",
        "privacy.disable-cross-device-clipboard",
        "privacy.activity-history"
      ]
    },
    {
      "id": "performance",
      "title": "Conservative performance profile",
      "description": "Avoids timer hacks, service purges, RAM cleaners, and blanket registry tuning.",
      "ruleIds": [
        "performance.menu-delay",
        "performance.visual-balanced",
        "repair.restore-balanced-power"
      ]
    },
    {
      "id": "gaming",
      "title": "Gaming profile",
      "description": "Supported Windows gaming controls only.",
      "ruleIds": [
        "gaming.game-mode",
        "gaming.disable-background-capture"
      ]
    },
    {
      "id": "developer",
      "title": "Developer workstation profile",
      "description": "Long paths, Developer Mode, WSL, and Virtual Machine Platform.",
      "ruleIds": [
        "developer.long-paths",
        "developer.developer-mode",
        "developer.wsl",
        "developer.virtual-machine-platform",
        "explorer.show-extensions",
        "explorer.full-path-title"
      ]
    },
    {
      "id": "security",
      "title": "Security hardening baseline",
      "description": "Disables obsolete optional features and enables Defender PUA protection.",
      "ruleIds": [
        "security.disable-smb1",
        "security.disable-powershell-v2",
        "security.pua-protection"
      ]
    },
    {
      "id": "repair",
      "title": "Repair defaults",
      "description": "Restores conservative power and Explorer defaults.",
      "ruleIds": [
        "repair.restore-balanced-power",
        "performance.visual-balanced",
        "explorer.show-extensions"
      ]
    }
  ]
}
