from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def replace_between(relative: str, start: str, end: str, replacement: str) -> None:
    path = ROOT / relative
    text = path.read_text(encoding="utf-8")
    left = text.find(start)
    right = text.find(end, left + len(start))
    if left < 0 or right < 0:
        raise RuntimeError(f"Could not locate replacement boundaries in {relative}")
    path.write_text(text[:left] + replacement + "\n\n" + text[right:], encoding="utf-8", newline="\n")


def replace_once(relative: str, old: str, new: str) -> None:
    path = ROOT / relative
    text = path.read_text(encoding="utf-8")
    if text.count(old) != 1:
        raise RuntimeError(f"Expected one occurrence in {relative}: {old!r}")
    path.write_text(text.replace(old, new), encoding="utf-8", newline="\n")


