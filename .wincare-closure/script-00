def find_block(text: str, brace: int) -> tuple[int, int]:
    depth = 0
    quote: str | None = None
    line_comment = False
    block_comment = False
    i = brace
    while i < len(text):
        c = text[i]
        n = text[i + 1] if i + 1 < len(text) else ''
        if line_comment:
            if c == '\n':
                line_comment = False
            i += 1
            continue
        if block_comment:
            if c == '#' and n == '>':
                block_comment = False
                i += 2
                continue
            i += 1
            continue
        if quote:
            if quote == '"' and c == '`':
                i += 2
                continue
            if c == quote:
                if i + 1 < len(text) and text[i + 1] == quote:
                    i += 2
                    continue
                quote = None
            i += 1
            continue
        if c == '<' and n == '#':
            block_comment = True
            i += 2
            continue
        if c == '#':
            line_comment = True
            i += 1
            continue
        if c in "'\"":
            quote = c
            i += 1
            continue
        if c == '{':
            depth += 1
        elif c == '}':
            depth -= 1
            if depth == 0:
                return brace, i + 1
        i += 1
    raise ValueError('unterminated PowerShell block')


def function_span(text: str, name: str) -> tuple[int, int]:
    match = re.search(rf'(?mi)^function\s+{re.escape(name)}\s*\{{', text)
    if not match:
        raise ValueError(f'function not found: {name}')
    _, end = find_block(text, match.end() - 1)
    while end < len(text) and text[end] in ' \t':
        end += 1
    if end < len(text) and text[end] == '\r':
        end += 1
    if end < len(text) and text[end] == '\n':
        end += 1
    return match.start(), end


def dynamic_block(path: Path, name: str) -> str:
    text = path.read_text(encoding='utf-8')
    match = re.search(rf'(?mi)^\$\{{function:{re.escape(name)}\}}\s*=\s*\{{', text)
    if not match:
        raise ValueError(f'dynamic function not found: {name}')
    _, end = find_block(text, match.end() - 1)
    body = text[match.start():end]
    body = re.sub(
        rf'^\$\{{function:{re.escape(name)}\}}\s*=\s*\{{',
        f'function {name} {{',
        body,
        count=1,
        flags=re.MULTILINE,
    )
    return body.rstrip() + '\n'


def variable_scriptblock(path: Path, variable: str, function_name: str) -> str:
    text = path.read_text(encoding='utf-8')
    match = re.search(rf'(?mi)^\${re.escape(variable)}\s*=\s*\{{', text)
    if not match:
        raise ValueError(f'scriptblock not found: {variable}')
    _, end = find_block(text, match.end() - 1)
    body = text[match.start():end]
    body = re.sub(
        rf'^\${re.escape(variable)}\s*=\s*\{{',
        f'function {function_name} {{',
        body,
        count=1,
        flags=re.MULTILINE,
    )
    return body.rstrip() + '\n'


def replace_function(path: Path, name: str, replacement: str) -> None:
    text = path.read_text(encoding='utf-8')
    start, end = function_span(text, name)
    path.write_text(
        text[:start] + replacement.rstrip() + '\n\n' + text[end:].lstrip('\n'),
        encoding='utf-8',
    )


